# Copia este fichero a .env. .env nunca se sube al repositorio.

# Postgres de desarrollo: docker compose -f despliegue/compose.dev.yml up -d
DATABASE_URL="postgres://sugardaddy:sugardaddy@localhost:5433/consola"

# Entra ID — tenant de seguridadsi.com (identidad). Sin esto, `npm run dev`
# entra en modo desarrollo (todos admin) y en producción la consola no arranca.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Object id del grupo de Entra con los usuarios de ESTE cliente.
ENTRA_GRUPO_CLIENTE=""

# Clave pública de publicación de SeguridadSI. Fijada aquí (en producción, dentro
# de la imagen): las versiones firmadas con cualquier otra clave se rechazan.
PUBLICACION_CLAVE_PUBLICA=""

# Token del actualizador local, el único proceso con el socket de Docker.
# Generar con: openssl rand -base64 48
ACTUALIZADOR_TOKEN=""

# Cada cuántos segundos late hacia el panel central.
LATIDO_SEGUNDOS="60"

# Token con el que los firewalls leen la lista EDL en /api/edl/negra.
EDL_TOKEN=""

# Grupo de Entra con el personal de soporte de SeguridadSI. Solo entra si el
# cliente abre el acceso de soporte desde Ajustes, y con el rol que él elija.
ENTRA_GRUPO_SOPORTE=""

# Clave con que se cifran los secretos de las salidas (avisos y SIEM). En el
# nodo la genera instalar.sh; aquí, con: openssl rand -hex 32
CLAVE_SECRETOS=""

 func buildNTLMChallenge(serverChallenge []byte, opts NTLMChallengeOptions) []byte {
+	// Sugardaddy: un Windows de grupo de trabajo anuncia su NOMBRE DE EQUIPO en
+	// el TargetName y en los campos de dominio del NTLM (NbDomainName,
+	// DnsDomainName), no la palabra "WORKGROUP" (eso delataba la trampa en
+	// rdp-ntlm-info). Si se configura un dominio DNS (SD_RDP_DOMINIO_DNS), el
+	// DnsDomainName lleva el FQDN y el DnsComputerName, equipo.FQDN.
+	nbDomain := opts.Domain
+	targetName := opts.Domain
+	dnsDomain := DominioDNS()
+	dnsComputer := opts.Computer
+	if esGrupoTrabajo(opts.Domain) {
+		nbDomain = opts.Computer
+		targetName = opts.Computer
+	}
+	if dnsDomain != "" {
+		dnsComputer = opts.Computer + "." + dnsDomain
+	} else if esGrupoTrabajo(opts.Domain) {
+		// Grupo de trabajo sin FQDN: el DnsDomainName es el propio equipo (un
+		// Windows standalone no tiene dominio DNS).
+		dnsDomain = opts.Computer
+	}
 	return ntlm.BuildChallenge(ntlm.ChallengeOptions{
 		ServerChallenge: serverChallenge,
-		Domain:          opts.Domain,
+		TargetName:      targetName,
+		Domain:          nbDomain,
 		Computer:        opts.Computer,
+		DnsDomain:       dnsDomain,
+		DnsComputer:     dnsComputer,
 		ClientFlags:     opts.ClientFlags,
 		Now:             opts.Now,
 		RichTargetInfo:  true,
 	})
 }
 
+// esGrupoTrabajo indica si el "dominio" es en realidad un grupo de trabajo (sin
+// dominio AD): vacío o "WORKGROUP" (sin distinguir mayúsculas).
+func esGrupoTrabajo(dominio string) bool {
+	return dominio == "" || strings.EqualFold(dominio, "WORKGROUP")
+}
+
 // Thin aliases so nla.go and tests keep a local vocabulary.
 func utf16LE(s string) []byte                        { return ntlm.EncodeUTF16LE(s) }
 func toFILETIME(t time.Time) uint64                  { return ntlm.ToFILETIME(t) }

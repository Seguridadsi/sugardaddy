+
+// recortarRecall acota la longitud de lo que se guarda en el almacén recall
+// (rutas y comandos del atacante), para que no retenga cadenas enormes por IP.
+func recortarRecall(s string) string {
+	if len(s) > 256 {
+		return s[:256]
+	}
+	return s
+}

+// dpBrute controla la fuerza bruta XOR de DoublePulsar: como mucho
+// maxDPBrutePorMin por minuto en toda la trampa.
+var dpBrute struct {
+	mu     sync.Mutex
+	minute int64
+	n      int
+}
+
+func dpBrutePermitido() bool {
+	dpBrute.mu.Lock()
+	defer dpBrute.mu.Unlock()
+	m := time.Now().Unix() / 60
+	if m != dpBrute.minute {
+		dpBrute.minute = m
+		dpBrute.n = 0
+	}
+	if dpBrute.n >= maxDPBrutePorMin {
+		return false
+	}
+	dpBrute.n++
+	return true

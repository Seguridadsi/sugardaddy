+
+// capPayload copia como mucho maxStoredPayload bytes del marco para guardarlos
+// en el evento, sin retener el buffer completo.
+func capPayload(b []byte) []byte {
+	if len(b) > maxStoredPayload {
+		b = b[:maxStoredPayload]
+	}
+	return append([]byte(nil), b...)

--- /dev/null
+++ b/internal/testutil/sugardaddy.go
@@ -0,0 +1,38 @@
+package testutil
+
+import (
+	"sync"
+	"time"
+
+	"github.com/telekom-security/ddospot/internal/limit"
+)
+
+// ReqObs is a limit.Observer and limit.Requester that keeps every request
+// (Sugardaddy). It is safe for concurrent use.
+type ReqObs struct {
+	NopObs
+	mu   sync.Mutex
+	reqs []limit.Source
+}
+
+func (r *ReqObs) Request(s limit.Source) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.reqs = append(r.reqs, s)
+}
+
+// Requests returns the requests kept so far.
+func (r *ReqObs) Requests() []limit.Source {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]limit.Source(nil), r.reqs...)
+}
+
+// RequestLimiter returns a limiter with the standard budgets that reports
+// every request to the returned ReqObs.
+func RequestLimiter() (*limit.Limiter, *ReqObs) {
+	obs := &ReqObs{}
+	cfg := limit.Defaults(time.Minute)
+	cfg.LogRequests = true
+	return limit.New(cfg, time.Now, obs), obs
+}

new file mode 100644
index 0000000..c21b41a
--- /dev/null
+++ b/internal/amp/amp_test.go
@@ -0,0 +1,99 @@
+package amp
+
+import (
+	"net/netip"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestFull(t *testing.T) {
+	g := New(false, []netip.Prefix{netip.MustParsePrefix("10.20.0.0/16"), netip.MustParsePrefix("192.168.1.0/24"),
+		netip.MustParsePrefix("172.16.0.0/12"), netip.MustParsePrefix("fd00::/8"), netip.MustParsePrefix("203.0.113.0/24")},
+		netip.MustParseAddr("172.18.0.1"))
+	for a, want := range map[string]bool{
+		"10.20.2.3":           true,
+		"192.168.1.20":        true,
+		"172.20.0.9":          true,
+		"::ffff:192.168.1.20": true,
+		"fd00::5":             true,
+		"203.0.113.9":         true, // public, but named internal
+		"127.0.0.1":           true,
+		"10.98.0.2":           false, // private, not named: the SNAT of a firewall
+		"192.168.2.20":        false,
+		"172.18.0.1":          false, // the proxy, inside 172.16/12
+		"::ffff:172.18.0.1":   false,
+		"198.51.100.7":        false,
+		"100.64.0.1":          false,
+		"169.254.1.1":         false,
+		"2001:db8::1":         false,
+		"8.8.8.8":             false,
+	} {
+		if g.Full(netip.MustParseAddr(a)) != want {
+			t.Errorf("%s: full %v", a, !want)
+		}
+	}
+	if !New(true, nil).Full(netip.MustParseAddr("198.51.100.7")) || !(*Guard)(nil).Full(netip.MustParseAddr("198.51.100.7")) {
+		t.Fatal("public on or nil guard limits")
+	}
+	pub := netip.MustParseAddr("198.51.100.7")
+	if !g.Allow(pub, 48, 48) || g.Allow(pub, 48, 49) || !g.Allow(netip.MustParseAddr("10.20.0.1"), 8, 600) {
+		t.Fatal("Allow")
+	}
+}
+
+// Hallazgo: con un cortafuegos que hace DNAT+SNAT delante (Azure Firewall,
+// VIP con NAT), todo Internet llega desde una IP privada que no es la
+// pasarela del contenedor. Sin redes internas declaradas, ninguna dirección
+// privada recibe respuestas más grandes que su petición; solo loopback.
+func TestPrivateIsNotInternalByItself(t *testing.T) {
+	g := New(false, nil, netip.MustParseAddr("10.98.0.1"))
+	for _, a := range []string{"10.98.0.2", "192.168.65.3", "172.17.0.5", "fd12::1", "::ffff:10.0.0.9"} {
+		if g.Full(netip.MustParseAddr(a)) || g.Allow(netip.MustParseAddr(a), 48, 592) {
+			t.Errorf("%s gets full answers without being an internal network", a)
+		}
+	}
+	if !g.Full(netip.MustParseAddr("127.0.0.1")) || !g.Full(netip.MustParseAddr("::1")) {
+		t.Error("loopback")
+	}
+}
+
+func TestParseNets(t *testing.T) {
+	got, err := ParseNets(" 10.20.0.0/16, 192.168.1.7/24,fd00::/8 ,::ffff:172.16.0.0/108,fc00::/7")
+	want := []netip.Prefix{netip.MustParsePrefix("10.20.0.0/16"), netip.MustParsePrefix("192.168.1.0/24"),
+		netip.MustParsePrefix("fd00::/8"), netip.MustParsePrefix("172.16.0.0/12"), netip.MustParsePrefix("fc00::/7")}
+	if err != nil || !slices.Equal(got, want) {
+		t.Fatalf("%v %v", got, err)
+	}
+	if n, err := ParseNets("  "); err != nil || n != nil {
+		t.Fatalf("empty: %v %v", n, err)
+	}
+	many := strings.Repeat("10.0.0.0/24,", MaxNets) + "10.0.1.0/24"
+	for _, bad := range []string{"10.0.0.0", "10.0.0.0/33", "0.0.0.0/0", "8.0.0.0/7", "::/0", "2000::/3", "10.0.0.0/8,", "x", "2000::/7", many, "fe80::%eth0/64"} {
+		if _, err := ParseNets(bad); err == nil {
+			t.Errorf("%q accepted", bad)
+		}
+	}
+}
+
+func TestGateways(t *testing.T) {
+	d := t.TempDir()
+	r4 := filepath.Join(d, "route")
+	r6 := filepath.Join(d, "ipv6_route")
+	// 172.18.0.1 as the kernel prints it on a little-endian host.
+	os.WriteFile(r4, []byte("Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n"+
+		"eth0\t00000000\t010012AC\t0003\t0\t0\t0\t00000000\t0\t0\t0\n"+
+		"eth0\t000012AC\t00000000\t0001\t0\t0\t0\t0000FFFF\t0\t0\t0\n"), 0o644)
+	os.WriteFile(r6, []byte("00000000000000000000000000000000 00 00000000000000000000000000000000 00 fd000000000000000000000000000001 00000400 00000001 00000000 00000003 eth0\n"+
+		"fd000000000000000000000000000000 40 00000000000000000000000000000000 00 00000000000000000000000000000000 00000100 00000001 00000000 00000001 eth0\n"), 0o644)
+	got := Gateways(r4, r6)
+	want := []netip.Addr{netip.MustParseAddr("172.18.0.1"), netip.MustParseAddr("fd00::1")}
+	if !slices.Equal(got, want) {
+		t.Fatalf("%v", got)
+	}
+	if len(Gateways(filepath.Join(d, "no"), filepath.Join(d, "no6"))) != 0 {
+		t.Fatal("missing files")
+	}
+}

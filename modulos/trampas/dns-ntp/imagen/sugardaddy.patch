+// Hallazgo: las peticiones UDP agotaban el presupuesto de líneas que también
+// usaban las TCP. Con el cubo de UDP vacío, una AXFR por TCP se apunta y la
+// siguiente petición UDP no.
+func TestTCPRequestsHaveTheirOwnBudget(t *testing.T) {
+	d := t.TempDir()
+	frozen := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	w, _ := jsonlog.Open(d, func() time.Time { return frozen })
+	w.Single("ddospot.json")
+	w.Cap(50 << 20)
+	l := New(w, "centos7")
+	l.Uniform, l.Requests = true, true
+	udp := limit.Source{Proto: limit.DNS, Port: 5353, Last: frozen, Packets: 1,
+		Sample: limit.Sample{Transport: "udp", Req: []byte{1}, ReqSize: 1, Fields: map[string]any{"dns_type": "A"}}}
+	for i := 0; i < 1000; i++ {
+		udp.Addr = netip.AddrFrom4([4]byte{10, 250, byte(i >> 8), byte(i)})
+		l.Request(udp)
+	}
+	tcp := limit.Source{Proto: limit.DNS, Addr: netip.MustParseAddr("10.250.100.1"), Port: 4001, Last: frozen, Packets: 1,
+		Sample: limit.Sample{Transport: "tcp", Req: []byte{1}, ReqSize: 1, Fields: map[string]any{"dns_type": "AXFR"}}}
+	l.Request(tcp)
+	l.Request(udp)
+	w.Close()
+	ev := readJSON(t, filepath.Join(d, "ddospot.json"))
+	if len(ev) != 151 || ev[150]["dns_type"] != "AXFR" || ev[150]["verified"] != true {
+		t.Fatalf("%d lines, last %v", len(ev), ev[len(ev)-1])
+	}
+}

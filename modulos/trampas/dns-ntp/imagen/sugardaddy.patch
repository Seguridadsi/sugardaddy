+	"testing"
+
+	"github.com/miekg/dns"
+
+	"github.com/telekom-security/ddospot/internal/amp"
+	"github.com/telekom-security/ddospot/internal/testutil"
+)
+
+func reqLen(t *testing.T, m *dns.Msg) int {
+	t.Helper()
+	b, err := m.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return len(b)
+}
+
+// Hallazgo: version.bind por UDP desde fuera volvía siempre con TC=1, una
+// huella de una sola sonda. Ahora, a un origen que no es de la red interna,
+// una pregunta CHAOS con respuesta se contesta REFUSED, sin TC, con solo la
+// pregunta y el OPT, por UDP y por TCP por igual (un BIND con allow-query
+// que lo deja fuera), como ya contesta a toda pregunta IN. A la red interna,
+// a loopback o con Public, la respuesta completa por los dos transportes.
+func TestGuardRefusesChaosToOutsiders(t *testing.T) {
+	lim, obs := testutil.RequestLimiter()
+	h := NewHandler(per("centos7"), lim, nil)
+	h.Guard = amp.New(false, []netip.Prefix{netip.MustParsePrefix("10.20.0.0/16"), netip.MustParsePrefix("172.16.0.0/12")},
+		netip.MustParseAddr("172.18.0.1"))
+	ver := query("version.bind.", dns.TypeTXT, dns.ClassCHAOS)
+	refused := func(m *dns.Msg, req *dns.Msg) bool {
+		return m != nil && !m.Truncated && m.Rcode == dns.RcodeRefused && !m.Authoritative && len(m.Answer) == 0 &&
+			len(m.Ns) == 0 && len(m.Question) == 1 && m.Question[0] == req.Question[0] && packedLen(m) <= reqLen(t, req)
+	}
+
+	if m := serve(t, h, udpFrom(), ver); !refused(m, ver) {
+		t.Fatalf("outside UDP: %v", m)
+	}
+	if r := obs.Requests(); len(r) != 1 || r[0].Sample.Fields["amp_guard"] != amp.Refused || r[0].Sample.RespSize != reqLen(t, ver) {
+		t.Fatalf("%+v", r)
+	}
+	edns := query("version.bind.", dns.TypeTXT, dns.ClassCHAOS)
+	edns.SetEdns0(1232, false)
+	if m := serve(t, h, udpFrom(), edns); !refused(m, edns) || m.IsEdns0() == nil {
+		t.Fatalf("outside UDP with EDNS: %v", m)
+	}
+	// Ni rellenando la petición hasta el tamaño de la respuesta.
+	padded := query("version.bind.", dns.TypeTXT, dns.ClassCHAOS)
+	padded.SetEdns0(1232, false)
+	padded.IsEdns0().Option = append(padded.IsEdns0().Option, &dns.EDNS0_PADDING{Padding: make([]byte, 200)})
+	if m := serve(t, h, udpFrom(), padded); !refused(m, padded) {
+		t.Fatalf("padded: %v", m)
+	}
+	// Por TCP lo mismo: la versión no sale por un transporte y no por el otro.
+	if m := serve(t, h, tcpFrom(), ver); !refused(m, ver) {
+		t.Fatalf("outside TCP: %v", m)
+	}
+	for _, name := range []string{"hostname.bind.", "id.server.", "version.server."} {
+		q := query(name, dns.TypeTXT, dns.ClassCHAOS)
+		if m := serve(t, h, udpFrom(), q); !refused(m, q) {
+			t.Fatalf("%s: %v", name, m)
+		}
+	}
+	in := query("intranet.corp.local.", dns.TypeANY, dns.ClassINET)
+	if m := serve(t, h, udpFrom(), in); m == nil || m.Truncated || m.Rcode != dns.RcodeRefused || packedLen(m) > reqLen(t, in) {
+		t.Fatalf("REFUSED: %v", m)
+	}
+	// El gateway del contenedor entrega paquetes de cualquiera, también dentro de 172.16/12.
+	if m := serve(t, h, &testutil.DNSRecorder{Remote: &net.UDPAddr{IP: net.IPv4(172, 18, 0, 1), Port: 40000}}, ver); !refused(m, ver) {
+		t.Fatalf("gateway: %v", m)
+	}
+	// Una IP privada que no es de la red interna (el SNAT de un cortafuegos).
+	if m := serve(t, h, &testutil.DNSRecorder{Remote: &net.UDPAddr{IP: net.IPv4(10, 98, 0, 2), Port: 40000}}, ver); !refused(m, ver) {
+		t.Fatalf("private, not internal: %v", m)
+	}
+	for name, w := range map[string]*testutil.DNSRecorder{
+		"internal udp": {Remote: &net.UDPAddr{IP: net.IPv4(10, 20, 0, 66), Port: 40000}},
+		"internal tcp": {Remote: &net.TCPAddr{IP: net.IPv4(10, 20, 0, 67), Port: 40000}},
+		"loopback":     {Remote: &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 40000}},
+	} {
+		if m := serve(t, h, w, ver); m == nil || m.Truncated || m.Rcode != dns.RcodeSuccess || len(m.Answer) != 1 || !m.Authoritative {
+			t.Fatalf("%s: %v", name, m)
+		}
+	}
+	h.Guard = amp.New(true, nil)
+	if m := serve(t, h, udpFrom(), ver); m == nil || m.Truncated || len(m.Answer) != 1 {
+		t.Fatalf("public on: %v", m)
+	}
+}
+
+// TC=1 queda solo para una respuesta IN que de verdad no cabe en la petición.
+func TestGuardTruncatesOnlyOversizedClassIN(t *testing.T) {
+	h := NewHandler(per("centos7"), nil, nil)
+	h.Guard = amp.New(false, nil)
+	q := query("www.example.com.", dns.TypeA, dns.ClassINET)
+	resp := new(dns.Msg)
+	resp.SetReply(q)
+	for i := 0; i < 4; i++ {
+		resp.Answer = append(resp.Answer, &dns.A{Hdr: dns.RR_Header{Name: q.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+			A: net.IPv4(192, 0, 2, byte(i))})
+	}
+	src := netip.MustParseAddrPort("198.51.100.9:4000")
+	if g := h.guard(src, resp.Copy(), reqLen(t, q), false); g != "" {
+		t.Fatalf("TCP: %q", g)
+	}
+	m := resp.Copy()
+	if g := h.guard(src, m, reqLen(t, q), true); g != amp.Truncated || !m.Truncated || len(m.Answer) != 0 || m.Rcode != dns.RcodeSuccess {
+		t.Fatalf("UDP: %q %v", g, m)
+	}
+}

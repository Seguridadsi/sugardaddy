+// guard keeps the answers of a source that may not get larger ones
+// (Sugardaddy) within the size of their requests, and the same on both
+// transports. It returns the amp_guard value of the log line, "" when the
+// answer goes as it is.
+//
+// A CHAOS question with an answer (version.bind, hostname.bind) is answered
+// REFUSED, over UDP and over TCP, with only the question and the OPT
+// record: what a BIND whose allow-query leaves the source out sends, and
+// what this server already answers to every question of class IN. A TC=1
+// without a reason of size, or a version over TCP that UDP refuses, would
+// tell a scanner what this is with one probe.
+//
+// Any other answer over UDP larger than its request keeps only its header,
+// question and OPT record, with TC=1: a real client asks again over TCP,
+// where the source cannot be forged. When even that is larger than the
+// request, it is not sent.
+func (h *Handler) guard(src netip.AddrPort, resp *dns.Msg, req int, udp bool) string {
+	if h.Guard.Full(src.Addr()) {
+		return ""
+	}
+	if len(resp.Question) == 1 && resp.Question[0].Qclass == dns.ClassCHAOS && len(resp.Answer) > 0 {
+		resp.Rcode = dns.RcodeRefused
+		resp.Authoritative = false
+		bare(resp)
+		if !udp || packedLen(resp) <= req {
+			return amp.Refused
+		}
+		return amp.Dropped
+	}
+	if !udp || packedLen(resp) <= req {
+		return ""
+	}
+	resp.Truncated = true
+	bare(resp)
+	if packedLen(resp) <= req {
+		return amp.Truncated
+	}
+	return amp.Dropped
+}

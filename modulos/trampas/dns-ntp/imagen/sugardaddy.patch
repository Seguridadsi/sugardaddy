+	if s["event"] != "scanner" || s["pot"] != "ntp" || s["dest_port"] != float64(123) || s["time"] != "2026-10-16 09:00:00.000000" || s["src_ip"] != "192.0.2.1" {
+		t.Fatalf("%v", s)
+	}
+	if ev[1]["event"] != "attack_start" || ev[1]["first_seen"] != "2026-10-16 09:00:00.000000" || ev[2]["time"] != "2026-10-16 09:01:00.000000" {
+		t.Fatalf("%v", ev[1:])
+	}
+}
+
+func TestRequestLines(t *testing.T) {
+	d := t.TempDir()

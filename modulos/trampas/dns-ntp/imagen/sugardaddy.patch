+// The guard is wired to the pots: with loopback as the gateway of the
+// container, mode 3 is answered and monlist is not, and its line says why.
+func TestSugardaddyGuardWired(t *testing.T) {
+	out := captureStdout(t)
+	d := t.TempDir()
+	route := filepath.Join(d, "route")
+	os.WriteFile(route, []byte("Iface\tDestination\tGateway \tFlags\neth0\t00000000\t0100007F\t0003\n"), 0o644)
+	old := routeFiles
+	routeFiles = [2]string{route, filepath.Join(d, "none")}
+	t.Cleanup(func() { routeFiles = old })
+	cfg := localConfig(d)
+	cfg.LogFile, cfg.LogRequests, cfg.Persona, cfg.MaxLogBytes = "ddospot.json", true, "centos7", DefaultMaxLogBytes
+	a, stop := startApp(t, cfg)
+	c, err := net.Dial("udp", a.NTP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	ask := func(req []byte) bool {
+		c.Write(req)
+		c.SetReadDeadline(time.Now().Add(300 * time.Millisecond))
+		_, err := c.Read(make([]byte, 2048))
+		return err == nil
+	}
+	mode3 := make([]byte, 48)
+	mode3[0] = 4<<3 | 3
+	if !ask(mode3) || ask(append([]byte{0x17, 0x00, 0x03, 0x2a}, make([]byte, 44)...)) {
+		t.Fatal("guard not wired")
+	}
+	if err := stop(); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), "public_amplification=off internal=[] proxies=[127.0.0.1]") {
+		t.Fatalf("%q", out.String())
+	}
+	var dropped int
+	for _, ev := range readJSON(t, filepath.Join(d, "ddospot.json")) {
+		if ev["event"] == "request" && ev["mode"] == "MONLIST" && ev["amp_guard"] == "sin respuesta" && ev["resp_size"] == float64(0) {
+			dropped++
+		}
+	}
+	if dropped != 1 {
+		t.Fatal("no line for the monlist without answer")
+	}
+}

+		t.Fatalf("%+v %v", c, err)
+	}
+	for _, bad := range []string{"10.20.0.0", "0.0.0.0/0", "10.0.0.0/8;", "todas", strings.Repeat("10.0.0.0/24,", 100)} {
+		if _, err := FromEnv(func(k string) string { return map[string]string{"DDOSPOT_INTERNAL_NETS": bad}[k] }); err == nil {
+			t.Errorf("%q aceptado", bad)
+		}
+	}
+	d := t.TempDir()
+	route := filepath.Join(d, "route")
+	// Pasarela 172.18.0.1, dentro de 172.16/12.
+	os.WriteFile(route, []byte("Iface\tDestination\tGateway \tFlags\neth0\t00000000\t010012AC\t0003\n"), 0o644)
+	old := routeFiles
+	routeFiles = [2]string{route, filepath.Join(d, "none")}
+	t.Cleanup(func() { routeFiles = old })
+	g, words := newGuard(c)
+	if words != "public_amplification=off internal=[10.20.0.0/16 192.168.1.0/24 172.16.0.0/12] proxies=[172.18.0.1]" {
+		t.Fatalf("%q", words)
+	}
+	for a, want := range map[string]bool{"10.20.3.4": true, "192.168.1.9": true, "172.20.0.2": true,
+		"172.18.0.1": false, "10.98.0.2": false, "192.168.65.3": false, "198.51.100.10": false} {
+		if g.Full(netip.MustParseAddr(a)) != want {
+			t.Errorf("%s: full %v", a, !want)
+		}
+	}
+	// Sin la variable, ninguna dirección privada recibe respuestas completas.
+	c, _ = FromEnv(func(string) string { return "" })
+	if g, _ := newGuard(c); g.Full(netip.MustParseAddr("10.98.0.2")) || g.Full(netip.MustParseAddr("192.168.1.9")) {

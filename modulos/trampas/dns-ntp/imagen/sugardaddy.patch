+package jsonlog
+
+import (
+	"encoding/json"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSingleFileRotatesByDay(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 23, 59, 59, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	w.Write("ntpot.log", map[string]any{"a": 1})
+	w.Write("targets.log", map[string]any{"b": 2})
+	now = now.Add(2 * time.Second)
+	w.Write("dnspot.log", map[string]any{"c": 3})
+	w.Close()
+	old, _ := os.ReadFile(filepath.Join(d, "ddospot.json.2026-10-16"))
+	cur, _ := os.ReadFile(filepath.Join(d, "ddospot.json"))
+	if strings.Count(string(old), "\n") != 2 || strings.TrimSpace(string(cur)) != `{"c":3}` {
+		t.Fatalf("rotado %q, actual %q", old, cur)
+	}
+	fi, err := os.Stat(filepath.Join(d, "ddospot.json"))
+	if err != nil || fi.Mode().Perm() != 0o644 {
+		t.Fatalf("permisos %v %v", fi.Mode(), err)
+	}
+	for _, f := range []string{"ntpot.log", "targets.log", "dnspot.log"} {
+		if _, err := os.Stat(filepath.Join(d, f)); err == nil {
+			t.Fatalf("%s creado en modo de un fichero", f)
+		}
+	}
+}
+
+func TestSingleFileLeftByEarlierDay(t *testing.T) {
+	d := t.TempDir()
+	p := filepath.Join(d, "ddospot.json")
+	os.WriteFile(p, []byte("viejo\n"), 0o644)
+	ayer := time.Date(2026, 10, 15, 12, 0, 0, 0, time.UTC)
+	os.Chtimes(p, ayer, ayer)
+	w, _ := Open(d, func() time.Time { return ayer.Add(24 * time.Hour) })
+	w.Single("ddospot.json")
+	w.Write("ssdpot.log", map[string]any{"n": 1})
+	w.Close()
+	if b, _ := os.ReadFile(p + ".2026-10-15"); string(b) != "viejo\n" {
+		t.Fatalf("%q", b)
+	}
+}
+
+// readLines returns the JSON lines of path.
+func readLines(t *testing.T, path string) []map[string]any {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []map[string]any
+	for _, l := range strings.Split(strings.TrimSpace(string(b)), "\n") {
+		if l == "" {
+			continue
+		}
+		var m map[string]any
+		if err := json.Unmarshal([]byte(l), &m); err != nil {
+			t.Fatalf("%q: %v", l, err)
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+// request is a request line of about size bytes at now, as events.Logger
+// writes it.
+func request(src netip.Addr, tcp bool, size int, now time.Time) map[string]any {
+	proto := "udp"
+	if tcp {
+		proto = "tcp"
+	}
+	return map[string]any{"event": "request", "time": Time(now), "src_ip": src.String(), "proto": proto, "verified": tcp,
+		"req_pkt": strings.Repeat("A", max(size-130, 0))}
+}
+
+func count(ev []map[string]any, f func(map[string]any) bool) int {
+	n := 0
+	for _, e := range ev {
+		if f(e) {
+			n++
+		}
+	}
+	return n
+}
+
+// Hallazgo: con ruido UDP de orígenes falsificados (unas 18 por segundo de
+// 34 orígenes durante 75 s) se perdían 9 de cada 10 transferencias de zona
+// por TCP, que compartían el cubo de líneas con el UDP. Cada clase de línea
+// tiene ahora su cubo: las diez AXFR quedan apuntadas.
+func TestUDPFloodKeepsTCPLines(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	w.Cap(50 << 20)
+	step := time.Second / 18
+	for i := 0; i < 75*18; i++ {
+		now = now.Add(step)
+		src := netip.AddrFrom4([4]byte{10, 250, byte(i % 34 / 8), byte(i % 34)})
+		o := Origin{Src: src}
+		if w.AllowFrom("dnspot.log", o) {
+			w.WriteFrom("dnspot.log", o, request(src, false, 960, now))
+		}
+		if i%135 == 67 { // ten AXFR over TCP from ten real hosts
+			axfr := netip.AddrFrom4([4]byte{10, 250, 100, byte(i / 135)})
+			o := Origin{Src: axfr, Verified: true}
+			if w.AllowFrom("dnspot.log", o) {
+				ev := request(axfr, true, 200, now)
+				ev["dns_type"] = "AXFR"
+				w.WriteFrom("dnspot.log", o, ev)
+			}
+		}
+	}
+	w.Notice(0)
+	w.Close()
+	ev := readLines(t, filepath.Join(d, "ddospot.json"))
+	axfr := count(ev, func(e map[string]any) bool { return e["dns_type"] == "AXFR" })
+	udp := count(ev, func(e map[string]any) bool { return e["proto"] == "udp" })
+	if axfr != 10 || udp > 150+4*76 || udp < 150+4*74 {
+		t.Fatalf("AXFR %d of 10, UDP %d", axfr, udp)
+	}
+	last := ev[len(ev)-1]
+	if last["event"] != DroppedEvent || last["dropped_udp"] != float64(75*18-udp) || last["dropped_tcp"] != nil ||
+		!strings.Contains(last["limits"].(string), "ritmo de líneas") || !strings.HasPrefix(last["top_sources"].(string), "10.250.") {
+		t.Fatalf("%v", last)
+	}
+}
+
+// Una inundación UDP de orígenes siempre nuevos todo un día: su parte del
+// día llega poco a poco, así que hay líneas UDP en cada hora en vez de
+// gastarlo todo en las primeras y callar hasta medianoche; cada minuto hay
+// un resumen de lo que se calla, las ráfagas tienen su parte, al final del
+// día cabe una petición TCP y el fichero no pasa del tope.
+func TestFloodIsSampledAllDay(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 0, 0, 0, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	const capBytes = 20 << 20
+	w.Cap(capBytes)
+	n := 0
+	for s := 0; s < 8640; s++ { // steps of 10 s
+		for i := 0; i < 60; i++ { // 6 a second, over the 4 of the line budget
+			n++
+			src := netip.AddrFrom4([4]byte{byte(1 + n>>24), byte(n >> 16), byte(n >> 8), byte(n)})
+			o := Origin{Src: src}
+			if w.AllowFrom("ntpot.log", o) {
+				w.WriteFrom("ntpot.log", o, request(src, false, 1000, now))
+			}
+		}
+		for i := 0; i < 5; i++ {
+			if w.Allow("targets.log") {
+				w.Write("targets.log", map[string]any{"event": "attack_start", "target_ip": "192.0.2.1", "req_pkt": strings.Repeat("B", 300)})
+			}
+		}
+		if s%6 == 5 {
+			w.Notice(3)
+		}
+		now = now.Add(10 * time.Second)
+	}
+	now = now.Add(-time.Second)
+	tcp := netip.MustParseAddr("10.0.0.9")
+	if !w.AllowFrom("dnspot.log", Origin{Src: tcp, Verified: true}) {
+		t.Fatal("no room for a request over TCP at the end of the day")
+	}
+	w.WriteFrom("dnspot.log", Origin{Src: tcp, Verified: true}, request(tcp, true, 300, now))
+	w.Close()
+	path := filepath.Join(d, "ddospot.json")
+	fi, _ := os.Stat(path)
+	if fi.Size() > capBytes {
+		t.Fatalf("%d bytes over the cap", fi.Size())
+	}
+	ev := readLines(t, path)
+	var hours [24]int
+	notices, targets := 0, 0
+	for _, e := range ev {
+		switch {
+		case e["event"] == "request" && e["proto"] == "udp":
+			tm, err := time.Parse("2006-01-02 15:04:05.000000", e["time"].(string))
+			if err != nil {
+				t.Fatal(err)
+			}
+			hours[tm.Hour()]++
+		case e["event"] == DroppedEvent:
+			notices++
+			if e["untracked"] != float64(3) {
+				t.Fatalf("%v", e)
+			}
+		case e["event"] == "attack_start":

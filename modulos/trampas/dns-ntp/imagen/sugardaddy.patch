+// Credibilidad: con el nombre por defecto (ns2) toda la flota tenía la misma
+// semilla y, con ella, el mismo UUID UPnP, puerto, servidor de hora y pares.
+// La semilla de la instancia, guardada en la carpeta de registros, hace que
+// dos trampas con los mismos parámetros no contesten como el mismo equipo y
+// que cada una siga siendo la misma tras reiniciar.
+func TestSugardaddySeedPerInstance(t *testing.T) {
+	env := func(dir string) Config {
+		c, err := FromEnv(func(k string) string {
+			return map[string]string{"DDOSPOT_LOG_DIR": dir, "DDOSPOT_LOG_FILE": "ddospot.json", "DDOSPOT_PERSONA": "debian11",
+				"DDOSPOT_HOSTNAME": "ns2", "DDOSPOT_LAN_IP": "192.168.1.53", "DDOSPOT_SEED": "ns2", "DDOSPOT_SEED_FILE": "persona.semilla"}[k]
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+	d1, d2 := t.TempDir(), t.TempDir()
+	a, again, other := rollPersona(env(d1)), rollPersona(env(d1)), rollPersona(env(d2))
+	if a.UUIDs[0] != again.UUIDs[0] || a.SSDPPort != again.SSDPPort || a.RefID != again.RefID {
+		t.Fatal("the same instance changed its persona on restart")
+	}
+	if a.UUIDs[0] == other.UUIDs[0] || a.SSDPPort == other.SSDPPort && a.ConfigID == other.ConfigID {
+		t.Fatalf("two instances with the same parameters answer as the same host: %v %v", a.UUIDs, other.UUIDs)
+	}
+	b, err := os.ReadFile(filepath.Join(d1, "persona.semilla"))
+	if err != nil || len(strings.TrimSpace(string(b))) != 64 {
+		t.Fatalf("%q %v", b, err)
+	}
+	// Un fichero que no es una semilla se rehace.
+	os.WriteFile(filepath.Join(d1, "persona.semilla"), []byte("x"), 0o600)
+	if c := rollPersona(env(d1)); c.UUIDs[0] == a.UUIDs[0] {
+		t.Fatal("broken seed file kept")
+	}
+	for _, bad := range []string{"../x", "ddospot.json.semilla", "ddospot.json"} {
+		if _, err := FromEnv(func(k string) string {
+			return map[string]string{"DDOSPOT_LOG_FILE": "ddospot.json", "DDOSPOT_SEED_FILE": bad}[k]
+		}); err == nil {
+			t.Errorf("%q accepted", bad)
+		}
+	}
+}

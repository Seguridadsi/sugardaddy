+// Hallazgo: el freno daba respuestas completas a todo origen privado que no
+// fuera la pasarela, y detrás de un cortafuegos con DNAT+SNAT eso es todo
+// Internet. Ahora solo las redes de DDOSPOT_INTERNAL_NETS (validadas al
+// arrancar: con una mal escrita no arranca) y nunca la pasarela.
+func TestSugardaddyInternalNets(t *testing.T) {
+	c, err := FromEnv(func(k string) string {

+package ssdp
+
+import (
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/telekom-security/ddospot/internal/amp"
+	"github.com/telekom-security/ddospot/internal/testutil"
+)
+
+// An M-SEARCH of a public source (loopback made a proxy) is counted with no
+// answer; one of a private source (loopback as it is) is answered.
+func TestGuardSSDP(t *testing.T) {
+	for _, c := range []struct {
+		proxies []netip.Addr
+		want    bool
+	}{{[]netip.Addr{netip.MustParseAddr("127.0.0.1")}, false}, {nil, true}} {
+		srv, cli := testutil.UDPPair(t)
+		lim, obs := testutil.RequestLimiter()
+		s := New(srv, lim, per("centos7"))
+		s.Guard = amp.New(false, nil, c.proxies...)
+		go s.Serve()
+		cli.Write(msearch("ssdp:all", "1"))
+		got := testutil.ReadTimeout(cli, 3*time.Second) > 0
+		s.Close()
+		r := obs.Requests()
+		if got != c.want || len(r) != 1 || (r[0].Sample.Fields["amp_guard"] == amp.Dropped) == c.want || r[0].Sample.Fields["st"] != "ssdp:all" {
+			t.Fatalf("proxies %v: answered %v, %+v", c.proxies, got, r)
+		}
+	}
+}
diff --git a/internal/testutil/sugardaddy.go b/internal/testutil/sugardaddy.go
new file mode 100644

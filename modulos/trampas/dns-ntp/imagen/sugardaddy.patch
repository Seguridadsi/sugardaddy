+		}
+	}
+	for h, c := range hours {
+		if c == 0 {
+			t.Fatalf("no UDP line in hour %d: %v", h, hours)
+		}
+	}
+	if notices != 1440 || targets == 0 || ev[len(ev)-1]["proto"] != "tcp" {
+		t.Fatalf("notices %d, targets %d, last %v", notices, targets, ev[len(ev)-1])
+	}
+	t.Logf("UDP lines per hour %v, %d bytes", hours, fi.Size())
+}
+
+// Un solo origen, por mucho que insista, no pasa del 2 % del día en cada
+// clase de línea: los demás siguen apuntándose y el resumen dice quién se
+// queda fuera y por qué. Un equipo IPv6 cuenta por su /64.
+func TestOneSourceCannotTakeTheDay(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	w.Cap(1 << 20) // 20971 bytes a source and kind
+	loud, other := netip.MustParseAddr("192.0.2.66"), netip.MustParseAddr("192.0.2.67")
+	write := func(src netip.Addr, tcp bool) bool {
+		now = now.Add(time.Second)
+		o := Origin{Src: src, Verified: tcp}
+		if !w.AllowFrom("dnspot.log", o) {
+			return false
+		}
+		before := w.bytes
+		w.WriteFrom("dnspot.log", o, request(src, tcp, 1000, now))
+		return w.bytes > before
+	}
+	n := 0
+	for i := 0; i < 100; i++ {
+		if write(loud, true) {
+			n++
+		}
+	}
+	if n < 19 || n > 21 {
+		t.Fatalf("one source wrote %d lines of 1000 bytes over TCP", n)
+	}
+	if !write(other, true) || !write(loud, false) {
+		t.Fatal("another source, or the same one over UDP, left out")
+	}
+	for _, a := range []string{"2001:db8::1", "2001:db8::2", "2001:db8::ffff:3"} {
+		for i := 0; i < 10; i++ {
+			write(netip.MustParseAddr(a), true)
+		}
+	}
+	if write(netip.MustParseAddr("2001:db8::4"), true) || !write(netip.MustParseAddr("2001:db8:0:1::4"), true) {
+		t.Fatal("IPv6 sources not counted by their /64")
+	}
+	w.Notice(0)
+	w.Close()
+	ev := readLines(t, filepath.Join(d, "ddospot.json"))
+	last := ev[len(ev)-1]
+	if last["event"] != DroppedEvent || last["limits"] != "cupo diario del origen" ||
+		!strings.HasPrefix(last["top_sources"].(string), "192.0.2.66 (") || !strings.Contains(last["top_sources"].(string), "2001:db8:: (") {
+		t.Fatalf("%v", last)
+	}
+}
+
+// La parte de un día de las peticiones UDP acaba con una línea log_full de
+// esa clase, pero las peticiones TCP siguen; el día siguiente empieza de
+// cero, rotado, y el fichero nunca pasa del tope.
+func TestSingleFileCapPerDay(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 23, 59, 0, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	w.Cap(100000) // 60000 for UDP, all but 32 bytes come by 23:59
+	for i := 0; i < 100; i++ {
+		now = now.Add(time.Second / 2)
+		if w.Allow("ntpot.log") {
+			w.Write("ntpot.log", map[string]any{"x": strings.Repeat("a", 990)})
+		}
+	}
+	if w.Allow("ntpot.log") {
+		t.Fatal("Allow with the share of UDP spent")
+	}
+	tcp := Origin{Src: netip.MustParseAddr("10.0.0.5"), Verified: true}
+	if !w.AllowFrom("dnspot.log", tcp) {
+		t.Fatal("TCP left out with the share of UDP spent")
+	}
+	w.WriteFrom("dnspot.log", tcp, map[string]any{"tcp": 1})
+	path := filepath.Join(d, "ddospot.json")
+	ev := readLines(t, path)
+	full := count(ev, func(e map[string]any) bool {
+		return e["event"] == FullEvent && e["kind"] == "peticiones UDP" && e["max_bytes"] == float64(100000) && e["kind_bytes"] == float64(60000)
+	})
+	if full != 1 || ev[len(ev)-1]["tcp"] != float64(1) || len(ev) < 55 {
+		t.Fatalf("%d lines, log_full %d", len(ev), full)
+	}
+	if fi, _ := os.Stat(path); fi.Size() > 100000 {
+		t.Fatalf("%d bytes", fi.Size())
+	}
+	now = time.Date(2026, 10, 17, 0, 0, 1, 0, time.UTC)
+	if !w.Allow("ntpot.log") {
+		t.Fatal("Allow on the next day")
+	}
+	w.Write("ntpot.log", map[string]any{"n": 1})
+	w.Close()
+	if b, _ := os.ReadFile(path); strings.TrimSpace(string(b)) != `{"n":1}` {
+		t.Fatalf("next day: %q", b)
+	}
+	if old := readLines(t, path+".2026-10-16"); len(old) != len(ev) {
+		t.Fatalf("rotated %d lines", len(old))
+	}
+}
+
+// earlierRun leaves in dir the single file of an earlier run of the same
+// day, of size bytes (sparse: the writer only looks at its size and date).
+func earlierRun(t *testing.T, dir string, size int64, at time.Time) string {
+	t.Helper()
+	p := filepath.Join(dir, "ddospot.json")
+	f, err := os.Create(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Truncate(size); err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	if err := os.Chtimes(p, at, at); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// Tras un reinicio el mismo día, lo que escribió la ejecución anterior
+// cuenta una sola vez: entero en el tope y en la parte de las líneas, y en
+// las partes que llegan a lo largo del día (UDP y ráfagas) solo lo que ya
+// podían haber gastado. Al final del día eso es toda la de UDP: las UDP se
+// callan, y se dice en el resumen, mientras las TCP y las ráfagas siguen.
+func TestSingleFileCapCountsEarlierRun(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 23, 59, 59, 0, time.UTC)
+	earlierRun(t, d, 70000, now.Add(-time.Hour))
+	w, _ := Open(d, func() time.Time { return now })
+	w.Single("ddospot.json")
+	w.Cap(100000)
+	w.Write("dnspot.log", map[string]any{"udp": 1})
+	if w.bytes != 70000 || w.used[unverified] != 59999 || w.used[targetKind] != 70000-59999 {
+		t.Fatalf("bytes %d, udp %d, ráfagas %d", w.bytes, w.used[unverified], w.used[targetKind])
+	}
+	tcp := Origin{Src: netip.MustParseAddr("10.0.0.5"), Verified: true}
+	w.WriteFrom("dnspot.log", tcp, map[string]any{"tcp": 1})
+	w.Write("targets.log", map[string]any{"event": "attack_start"})
+	w.Notice(0)
+	w.Close()
+	b, _ := os.ReadFile(filepath.Join(d, "ddospot.json"))
+	lines := strings.Split(strings.TrimSpace(string(b[70000:])), "\n")
+	if len(lines) != 3 || lines[0] != `{"tcp":1}` || lines[1] != `{"event":"attack_start"}` ||
+		!strings.Contains(lines[2], `"dropped_udp":1`) || !strings.Contains(lines[2], `"limits":"reparto del día"`) {
+		t.Fatalf("%q", lines)
+	}
+}
+
+// Hallazgo: al reiniciar el mismo día, todo lo ya escrito (también las
+// líneas TCP y los avisos) se cobraba a la parte UDP, que llega a lo largo
+// del día, y con una inundación pasaban horas sin una línea UDP (a las
+// 15:00, hasta las 18:25). Ahora a UDP solo se le cobra lo que podía haber
+// gastado a esa hora, y su parte crece cada segundo: con la inundación
+// siguiendo, hay líneas UDP en los primeros segundos y en cada diez
+// minutos, las TCP siguen, y la mañana no se cuenta dos veces.
+func TestRestartSameDayKeepsUDPUnderFlood(t *testing.T) {
+	const capBytes = 50 << 20
+	for _, tc := range []struct {
+		name string
+		at   time.Time
+		size func(w *Writer, now time.Time) int64
+	}{
+		// Inundación UDP desde medianoche, gastando su parte al ritmo
+		// del día, más 3,2 MB de TCP y 172 KB de avisos.
+		{"15:00 tras inundación UDP y TCP", time.Date(2026, 10, 16, 15, 0, 0, 0, time.UTC),
+			func(w *Writer, now time.Time) int64 { return w.limitOf(unverified, now) + 3198089 + 172325 }},
+		// Una mañana de TCP sin inundación: más que las partes de UDP y
+		// ráfagas juntas a esa hora.
+		{"06:00 tras una mañana de TCP", time.Date(2026, 10, 16, 6, 0, 0, 0, time.UTC),
+			func(*Writer, time.Time) int64 { return 30 << 20 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			d := t.TempDir()
+			now := tc.at
+			w, _ := Open(d, func() time.Time { return now })
+			w.Single("ddospot.json")
+			w.Cap(capBytes)
+			size := tc.size(w, now)
+			earlierRun(t, d, size, now.Add(-time.Minute))
+			var firstUDP time.Time
+			var windows [6]int // UDP lines in each ten minutes of the hour
+			tcpLines, n := 0, 0
+			for s := 0; s < 3600; s++ {
+				for i := 0; i < 4; i++ { // new forged sources, 4 a second
+					n++
+					src := netip.AddrFrom4([4]byte{byte(1 + n>>24), byte(n >> 16), byte(n >> 8), byte(n)})
+					o := Origin{Src: src}
+					if w.AllowFrom("ntpot.log", o) {
+						before := w.used[unverified]
+						w.WriteFrom("ntpot.log", o, request(src, false, 400, now))
+						if w.used[unverified] > before {
+							windows[s/600]++
+							if firstUDP.IsZero() {
+								firstUDP = now
+							}
+						}
+					}
+				}
+				if s%10 == 0 {
+					src := netip.AddrFrom4([4]byte{10, 0, byte(s >> 8), byte(s)})
+					o := Origin{Src: src, Verified: true}
+					before := w.used[verified]
+					if w.AllowFrom("dnspot.log", o) {
+						w.WriteFrom("dnspot.log", o, request(src, true, 600, now))
+					}
+					if w.used[verified] > before {
+						tcpLines++
+					}
+				}
+				if s == 0 {
+					// The earlier bytes count once: whole in the cap, and in
+					// the paced shares no more than they had come by now.
+					if w.bytes < size || w.used[unverified] > w.limitOf(unverified, now) ||
+						w.used[targetKind] > w.limitOf(targetKind, now) || w.used[unverified]+w.used[targetKind] > size {
+						t.Fatalf("bytes %d de %d, udp %d (hasta %d), ráfagas %d (hasta %d)", w.bytes, size,
+							w.used[unverified], w.limitOf(unverified, now), w.used[targetKind], w.limitOf(targetKind, now))
+					}
+				}
+				if s%60 == 59 {
+					w.Notice(0)
+				}
+				now = now.Add(time.Second)
+			}
+			w.Close()
+			if firstUDP.IsZero() || firstUDP.Sub(tc.at) > 5*time.Second {
+				t.Fatalf("primera línea UDP a las %v tras reiniciar a las %v", firstUDP.Format("15:04:05"), tc.at.Format("15:04:05"))
+			}
+			for i, c := range windows {
+				if c == 0 {
+					t.Fatalf("sin líneas UDP entre el minuto %d y el %d: %v", i*10, i*10+10, windows)
+				}
+			}
+			if tcpLines != 360 {
+				t.Fatalf("%d de 360 peticiones TCP", tcpLines)
+			}
+			if fi, _ := os.Stat(filepath.Join(d, "ddospot.json")); fi.Size() > capBytes {
+				t.Fatalf("%d bytes, más que el tope", fi.Size())
+			}
+			t.Logf("primera UDP %v, UDP cada diez minutos %v", firstUDP.Format("15:04:05"), windows)
+		})
+	}
+}
+
+// Sin nada callado no hay resumen; con tablas llenas en el limitador, sí.
+func TestNoticeOnlyWhenSomethingIsLeftOut(t *testing.T) {
+	d := t.TempDir()
+	now := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	w, _ := Open(d, func() time.Time { return now })
+	w.Notice(5) // five files: no notices
+	w.Single("ddospot.json")
+	w.Cap(50 << 20)
+	w.Write("ssdpot.log", map[string]any{"a": 1})
+	w.Notice(0)
+	w.Notice(7)
+	w.Notice(0)
+	w.Close()
+	w.Notice(9)
+	ev := readLines(t, filepath.Join(d, "ddospot.json"))
+	if len(ev) != 2 || ev[1]["event"] != DroppedEvent || ev[1]["untracked"] != float64(7) || ev[1]["dropped"] != float64(0) ||
+		ev[1]["time"] != "2026-10-16 12:00:00.000000" {
+		t.Fatalf("%v", ev)
+	}
+	if _, err := os.Stat(filepath.Join(d, "ssdpot.log")); err == nil {
+		t.Fatal("five-file notice")
+	}
+}

+	l.Uniform, l.Requests = true, true
+	src := limit.Source{Proto: limit.DNS, Addr: netip.MustParseAddr("192.0.2.1"), Port: 4001, Packets: 2,
+		First: time.Date(2026, 10, 16, 9, 0, 0, 0, time.UTC), Last: time.Date(2026, 10, 16, 9, 0, 1, 0, time.UTC),
+		Sample: limit.Sample{Transport: "tcp", Req: []byte{1, 2}, ReqSize: 2, RespSize: 39, Fields: map[string]any{"dns_type": "AXFR"}}}
+	l.Request(src)
+	l.Scanner(src)
+	w.Close()
+	ev := readJSON(t, filepath.Join(d, "ddospot.json"))
+	if len(ev) != 1 {
+		t.Fatalf("%v", ev)
+	}
+	q := ev[0]
+	if q["event"] != "request" || q["pot"] != "dns" || q["dest_port"] != float64(53) || q["src_port"] != float64(4001) ||
+		q["packets"] != float64(2) || q["verified"] != true || q["dns_type"] != "AXFR" || q["time"] != "2026-10-16 09:00:01.000000" {

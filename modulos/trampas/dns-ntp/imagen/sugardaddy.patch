+// Without a SeedFile it returns "".
+func instanceSeed(cfg Config) (string, error) {
+	if cfg.SeedFile == "" {
+		return "", nil
+	}
+	path := filepath.Join(cfg.LogDir, cfg.SeedFile)
+	if b, err := os.ReadFile(path); err == nil {
+		if s := strings.TrimSpace(string(b)); len(s) == 64 {
+			if _, err := hex.DecodeString(s); err == nil {
+				return s, nil

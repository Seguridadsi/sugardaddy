+		First: time.Date(2026, 10, 16, 9, 0, 0, 0, time.UTC), Last: time.Date(2026, 10, 16, 9, 1, 0, 0, time.UTC), Packets: 9,
+		Sample: limit.Sample{Transport: "udp", Req: []byte{1}, ReqSize: 1, Fields: map[string]any{"mode": "MONLIST"}}}
+	l.Scanner(src)

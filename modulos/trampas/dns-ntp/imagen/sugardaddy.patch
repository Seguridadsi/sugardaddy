+package limit
+
+import (
+	"net/netip"
+	"testing"
+	"time"
+)
+
+// With LogBlocked a noisy source of a blocked network is still a target,
+// and a quiet one still a scanner; neither gets an answer.
+func TestLogBlocked(t *testing.T) {
+	c := &clock{t: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}
+	r := &rec{}
+	cfg := Defaults(10 * time.Second)
+	cfg.LogBlocked = true
+	l := New(cfg, func() time.Time { return c.t }, r)
+	for i := 0; i < 21; i++ { // one source blocks its /24
+		l.Admit(DNS, ap("10.20.0.5:4000"), Sample{}, 1, 50)
+	}
+	if len(r.nstart) != 1 || len(r.tstart) != 1 {
+		t.Fatalf("net %d target %d", len(r.nstart), len(r.tstart))
+	}
+	if l.Admit(NTP, ap("10.20.0.7:4000"), Sample{}, 1, 48) {
+		t.Fatal("answered in a blocked network")
+	}
+	for i := 0; i < 6; i++ {
+		l.Admit(SSDP, ap("10.20.0.8:4000"), Sample{}, 1, 300)
+	}
+	c.t = c.t.Add(11 * time.Second)
+	l.Tick()
+	got := map[netip.Addr]bool{}
+	for _, s := range r.scanner {
+		got[s.Addr] = true
+	}
+	if !got[netip.MustParseAddr("10.20.0.7")] || len(r.tstart) != 2 || r.tstart[1].Addr != netip.MustParseAddr("10.20.0.8") {
+		t.Fatalf("scanners %v targets %v", r.scanner, r.tstart)
+	}
+}
+
+type reqRec struct {
+	rec
+	reqs []Source
+}
+
+func (r *reqRec) Request(s Source) { r.reqs = append(r.reqs, s) }
+
+// With LogRequests every packet within the budget of its source is a
+// request, with its own sample and port; the packets beyond it are not.
+func TestLogRequests(t *testing.T) {
+	c := &clock{t: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}
+	r := &reqRec{}
+	cfg := Defaults(10 * time.Second)
+	cfg.LogRequests = true
+	l := New(cfg, func() time.Time { return c.t }, r)
+	for i := 0; i < 7; i++ {
+		l.Admit(DNS, netip.AddrPortFrom(netip.MustParseAddr("10.20.0.5"), uint16(4000+i)),
+			Sample{Transport: "udp", Req: []byte{byte(i)}, Fields: map[string]any{"dns_name": i}}, 1, 50)
+	}
+	for i := 0; i < 7; i++ {
+		l.Admit(DNS, ap("10.30.0.5:5000"), Sample{Transport: "tcp", Req: []byte{9}}, 1, 50)
+	}
+	if len(r.reqs) != 10 || len(r.tstart) != 1 {
+		t.Fatalf("requests %d targets %d", len(r.reqs), len(r.tstart))
+	}
+	q := r.reqs[4]
+	if q.Packets != 5 || q.Port != 4004 || q.Sample.Fields["dns_name"] != 4 || q.Sample.Req[0] != 4 {
+		t.Fatalf("%+v", q)
+	}
+	if r.reqs[9].Sample.Transport != "tcp" || r.reqs[9].Packets != 5 {
+		t.Fatalf("%+v", r.reqs[9])
+	}
+}
+
+// Private sources get the private budgets; public ones keep theirs.
+func TestPrivateBudgets(t *testing.T) {
+	c := &clock{t: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}
+	r := &rec{}
+	cfg := Defaults(10 * time.Second)
+	cfg.PerSourcePrivate, cfg.PerNetPrivate = 20, 200
+	l := New(cfg, func() time.Time { return c.t }, r)
+	answered := func(src string, n int) (k int) {
+		for i := 0; i < n; i++ {
+			if l.Admit(NTP, ap(src), Sample{}, 1, 48) {
+				k++
+			}
+		}
+		return k
+	}
+	if k := answered("10.20.0.5:4000", 30); k != 20 || len(r.tstart) != 1 {
+		t.Fatalf("private: %d answers, %d targets", k, len(r.tstart))
+	}
+	if l.Over(NTP, ap("10.20.0.6:4000"), false) || !l.Over(NTP, ap("10.20.0.5:4000"), false) {
+		t.Fatal("Over does not follow the private budgets")
+	}
+	c.t = c.t.Add(2 * time.Second) // the global budget fills again
+	if k := answered("198.51.100.5:4000", 10); k != 5 || len(r.tstart) != 2 {
+		t.Fatalf("public: %d answers, %d targets", k, len(r.tstart))
+	}
+	if len(r.nstart) != 0 {
+		t.Fatalf("network blocked: %v", r.nstart)
+	}
+}
+
+// Con la tabla de orígenes llena, los nuevos ni se contestan ni se apuntan:
+// el limitador lo cuenta para que el registro lo diga en su resumen.
+func TestUntrackedCountsFullTables(t *testing.T) {
+	cfg := Defaults(10 * time.Second)
+	cfg.MaxSources, cfg.MaxNets, cfg.MaxTCPSources = 2, 100, 1
+	l := New(cfg, time.Now, &rec{})
+	s := Sample{Transport: "udp", Req: []byte{1}}
+	for i := 0; i < 5; i++ {
+		l.Admit(NTP, netip.AddrPortFrom(netip.AddrFrom4([4]byte{192, 0, 2, byte(i)}), 123), s, 1, 48)
+	}
+	tcp := Sample{Transport: "tcp", Req: []byte{1}}
+	l.Admit(DNS, netip.MustParseAddrPort("192.0.2.9:4000"), tcp, 0, 0)
+	l.Admit(DNS, netip.MustParseAddrPort("192.0.2.10:4000"), tcp, 0, 0)
+	if n := l.Untracked(); n != 4 {
+		t.Fatalf("untracked %d, want 4", n)
+	}
+	if n := l.Untracked(); n != 0 {
+		t.Fatalf("not reset: %d", n)
+	}
+}

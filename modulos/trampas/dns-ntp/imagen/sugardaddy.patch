+func TestSugardaddyEnv(t *testing.T) {
+	env := map[string]string{"DDOSPOT_LOG_FILE": "ddospot.json", "DDOSPOT_PERSONA": "debian11", "DDOSPOT_HOSTNAME": "ns2",
+		"DDOSPOT_LAN_IP": "10.20.0.53", "DDOSPOT_SEED": "ns2", "DDOSPOT_LOG_BLOCKED": "on", "DDOSPOT_MAX_SOURCES": "50000", "DDOSPOT_LOG_REQUESTS": "on", "DDOSPOT_PRIVATE_BUDGET": "50"}
+	c, err := FromEnv(func(k string) string { return env[k] })
+	if err != nil || c.Recursion || c.LogFile != "ddospot.json" || c.Persona != "debian11" || c.Hostname != "ns2" ||
+		c.LAN != netip.MustParseAddr("10.20.0.53") || c.Seed != "ns2" || !c.LogBlocked || c.MaxSources != 50000 || !c.LogRequests || c.PrivateBudget != 50 {
+		t.Fatalf("%+v %v", c, err)
+	}
+	for k, v := range map[string]string{"DDOSPOT_DNS_RECURSION": "on", "DDOSPOT_LOG_FILE": "../x", "DDOSPOT_PERSONA": "win2019",
+		"DDOSPOT_HOSTNAME": "a b", "DDOSPOT_LAN_IP": "2001:db8::1", "DDOSPOT_LOG_BLOCKED": "yes", "DDOSPOT_MAX_SOURCES": "0999", "DDOSPOT_LOG_REQUESTS": "1", "DDOSPOT_PRIVATE_BUDGET": "4"} {
+		if _, err := FromEnv(func(x string) string {
+			if x == k {
+				return v
+			}
+			return ""
+		}); err == nil {
+			t.Errorf("%s=%q aceptado", k, v)
+		}
+	}
+	a, b := rollPersona(c), rollPersona(c)
+	if a.ID != "debian11" || a.Hostname != "ns2" || a.LAN != c.LAN || a.UUIDs[0] != b.UUIDs[0] || a.SSDPPort != b.SSDPPort {
+		t.Fatalf("%+v\n%+v", a, b)
+	}
+	for _, p := range a.Peers {
+		if p.Is4() && p.As4()[0] == 10 && (p.As4()[1] != 20 || p.As4()[2] != 0) {
+			t.Fatalf("par fuera de la red del anfitrión: %v", p)
+		}
+	}

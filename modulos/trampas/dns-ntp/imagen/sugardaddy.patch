+// Inside the container the pots listen on ports of 1024 or more, as the
+// image sets: without root or capabilities a lower one only binds where the
+// kernel lets anybody do it, and not in CentOS/RHEL 7 or Podman.
+func TestSugardaddyPortsEnv(t *testing.T) {
+	ports := map[string]string{"DDOSPOT_CHARGEN_PORT": "10019", "DDOSPOT_DNS_PORT": "1053", "DDOSPOT_NTP_PORT": "1123", "DDOSPOT_SSDP_PORT": "11900"}
+	c, err := FromEnv(func(k string) string { return ports[k] })
+	if err != nil || c.Chargen != ":10019" || c.DNS != ":1053" || c.NTP != ":1123" || c.SSDP != ":11900" {
+		t.Fatalf("%+v %v", c, err)
+	}
+	// Each on its own: unset, the well-known one.
+	c, err = FromEnv(func(k string) string { return map[string]string{"DDOSPOT_DNS_PORT": "1053"}[k] })
+	if err != nil || c.Chargen != ":19" || c.DNS != ":1053" || c.NTP != ":123" || c.SSDP != ":1900" {
+		t.Fatalf("%+v %v", c, err)
+	}
+	for _, k := range []string{"DDOSPOT_CHARGEN_PORT", "DDOSPOT_DNS_PORT", "DDOSPOT_NTP_PORT", "DDOSPOT_SSDP_PORT"} {
+		for _, v := range []string{"0", "65536", "01053", "+1053", "-1", "1053 ", "53a", "1e3"} {
+			if _, err := FromEnv(func(x string) string {
+				if x == k {
+					return v
+				}
+				return ""
+			}); err == nil {
+				t.Errorf("%s=%q aceptado", k, v)
+			}
+		}
+	}
+	// Two UDP pots cannot share a port, with it set or by default.
+	for _, env := range []map[string]string{
+		{"DDOSPOT_DNS_PORT": "1053", "DDOSPOT_NTP_PORT": "1053"},
+		{"DDOSPOT_SSDP_PORT": "123"},
+	} {
+		if _, err := FromEnv(func(k string) string { return env[k] }); err == nil || !strings.Contains(err.Error(), "repeats the port") {
+			t.Errorf("%v: %v", env, err)
+		}
+	}
+	// And they really listen there.
+	free := func() string {
+		pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer pc.Close()
+		return strings.TrimPrefix(pc.LocalAddr().String(), "127.0.0.1:")
+	}
+	got := map[string]string{"DDOSPOT_CHARGEN_PORT": free(), "DDOSPOT_DNS_PORT": free(), "DDOSPOT_NTP_PORT": free(), "DDOSPOT_SSDP_PORT": free()}
+	if c, err = FromEnv(func(k string) string { return got[k] }); err != nil {
+		t.Skipf("puertos libres repetidos: %v", err)
+	}
+	ls, err := listen(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ls.close()
+	for _, x := range []struct {
+		env  string
+		addr net.Addr
+	}{{"DDOSPOT_CHARGEN_PORT", ls.chargen.LocalAddr()}, {"DDOSPOT_DNS_PORT", ls.dns.LocalAddr()}, {"DDOSPOT_DNS_PORT", ls.tcp.Addr()},
+		{"DDOSPOT_NTP_PORT", ls.ntp.LocalAddr()}, {"DDOSPOT_SSDP_PORT", ls.ssdp.LocalAddr()}} {
+		if !strings.HasSuffix(x.addr.String(), ":"+got[x.env]) {
+			t.Errorf("%s=%s escucha en %s", x.env, got[x.env], x.addr)
+		}
+	}
+}

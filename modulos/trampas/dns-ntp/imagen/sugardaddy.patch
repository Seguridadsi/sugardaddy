--- /dev/null
+++ b/internal/ntp/sugardaddy_test.go
@@ -0,0 +1,39 @@
+package ntp
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/telekom-security/ddospot/internal/amp"
+	"github.com/telekom-security/ddospot/internal/testutil"
+)
+
+var monlist48 = append([]byte{0x17, 0x00, 0x03, 0x2a}, make([]byte, 44)...)
+
+// From a public source (here loopback, made a proxy) mode 3 is answered,
+// 48 bytes for 48; monlist and READVAR, larger than their requests, are
+// counted with no answer. Loopback as it is gets them.
+func TestGuardNTP(t *testing.T) {
+	srv, cli := testutil.UDPPair(t)
+	lim, obs := testutil.RequestLimiter()
+	s := New(srv, lim, per("centos7"))
+	s.Guard = amp.New(false, nil, netip.MustParseAddr("127.0.0.1"))
+	go s.Serve()
+	readvar := []byte{0x16, 0x02, 0x00, 0x01, 0, 0, 0, 0, 0, 0, 0, 0}
+	if !answered(t, cli, client(4)) || answered(t, cli, monlist48) || answered(t, cli, readvar) {
+		t.Fatal("public source")
+	}
+	r := obs.Requests()
+	if len(r) != 3 || r[0].Sample.Fields["amp_guard"] != nil || r[1].Sample.Fields["amp_guard"] != amp.Dropped ||
+		r[1].Sample.Fields["mode"] != "MONLIST" || r[1].Sample.RespSize != 0 || r[2].Sample.Fields["mode"] != "CONTROL" {
+		t.Fatalf("%+v", r)
+	}
+
+	srv2, cli2 := testutil.UDPPair(t)
+	s2 := New(srv2, lim, per("centos7"))
+	s2.Guard = amp.New(false, nil)
+	go s2.Serve()
+	if !answered(t, cli2, monlist48) || !answered(t, cli2, readvar) {
+		t.Fatal("private source")
+	}
+}

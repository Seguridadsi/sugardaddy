+// Cada minuto (y al parar) el registro único apunta lo que se ha callado,
+// también los paquetes de orígenes nuevos que no cupieron en las tablas.
+func TestSugardaddyNoticeWired(t *testing.T) {
+	out := captureStdout(t)
+	d := t.TempDir()
+	jl, _ := jsonlog.Open(d, time.Now)
+	jl.Single("ddospot.json")
+	jl.Cap(DefaultMaxLogBytes)
+	lc := limit.Defaults(time.Minute)
+	lc.MaxSources, lc.MaxNets = 1, 1
+	lim := limit.New(lc, time.Now, events.New(jl, "centos7"))
+	s := limit.Sample{Transport: "udp", Req: []byte{1}}
+	for i := 0; i < 3; i++ {
+		lim.Admit(limit.NTP, netip.AddrPortFrom(netip.AddrFrom4([4]byte{192, 0, 2, byte(i)}), 123), s, 1, 48)
+	}
+	notice(stdout, jl, lim)
+	jl.Close()
+	ev := readJSON(t, filepath.Join(d, "ddospot.json"))
+	if len(ev) != 1 || ev[0]["event"] != "log_dropped" || ev[0]["untracked"] != float64(2) {
+		t.Fatalf("%v", ev)
+	}
+	if !strings.Contains(out.String(), "tables full: 2") {
+		t.Fatalf("%q", out.String())
+	}
+}

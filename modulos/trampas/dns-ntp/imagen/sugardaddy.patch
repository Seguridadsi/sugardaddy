 // RollAt is Roll with the boot time counted back from now: the same seed
 // and the same now give the same persona.
-func RollAt(r *rand.Rand, now time.Time) Persona {
+func RollAt(r *rand.Rand, now time.Time) Persona { return RollFixed(r, now, "", "", netip.Addr{}) }
+
+// RollFixed is RollAt with the profile, the host name and the LAN address
+// chosen by the caller (Sugardaddy); an empty value is rolled as in RollAt.
+// The random numbers are drawn in the same order either way, so the other
+// details stay those of the same seed.
+func RollFixed(r *rand.Rand, now time.Time, id, hostname string, lan netip.Addr) Persona {
 	cat := Catalog()
 	p := Persona{Profile: cat[r.Intn(len(cat))]}
+	for _, c := range cat {
+		if c.ID == id {
+			p.Profile = c
+		}
+	}
 	p.Hostname = hostnames[r.Intn(len(hostnames))]
+	if hostname != "" {
+		p.Hostname = hostname
+	}
 	p.LAN = rollLAN(r)
+	if lan.Is4() {
+		p.LAN = lan
+	}
 
 	upstream := serversOfStratum(p.NTP.Stratum - 1)
 	p.RefID = upstream[r.Intn(len(upstream))]

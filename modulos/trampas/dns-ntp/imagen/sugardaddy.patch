diff --git a/internal/amp/amp.go b/internal/amp/amp.go
new file mode 100644
index 0000000..d8de9af
--- /dev/null
+++ b/internal/amp/amp.go
@@ -0,0 +1,193 @@
+// Package amp keeps the UDP pots from answering a source on the Internet
+// with more bytes than it sent (Sugardaddy). A UDP source can be forged:
+// whatever the budgets, a pot that answers a forged source with more bytes
+// than the request is a reflector, and scanners of the Internet list the
+// address of the host as one.
+package amp
+
+import (
+	"bufio"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// Values of the amp_guard field of a log line.
+const (
+	// Truncated: the answer kept only its header and question (DNS, TC=1).
+	Truncated = "recortada"
+	// Dropped: no answer, it would have been larger than the request.
+	Dropped = "sin respuesta"
+	// Refused: a CHAOS question (version.bind) of a source that may not get
+	// larger answers is answered REFUSED over UDP and TCP alike, as a BIND
+	// whose allow-query leaves it out (DNS).
+	Refused = "rechazada"
+)
+
+// Guard tells which sources may get answers larger than their requests.
+// A nil Guard lets every source get them, as the original DDoSPot does.
+//
+// Being a private address (RFC 1918, fc00::/7) is not enough: a firewall
+// that translates the source of what it lets in (DNAT with SNAT, as Azure
+// Firewall always does, a FortiGate VIP with NAT, a hide NAT) hands over
+// the whole Internet from one private address. Only the networks the
+// operator names as internal, and loopback, get full answers.
+type Guard struct {
+	// Public lets every source get them, within the budgets of the
+	// limiter (DDOSPOT_PUBLIC_AMPLIFICATION=on).
+	Public   bool
+	internal []netip.Prefix
+	proxies  map[netip.Addr]bool
+}
+
+// New returns a Guard. internal are the networks whose sources get full
+// answers (DDOSPOT_INTERNAL_NETS); none means that only loopback does. The
+// proxies are addresses that hand over packets of anyone, such as the
+// gateway of the container: Docker's userland proxy sends the packets of
+// loopback and IPv6 clients from it, and their true source is unknown.
+// They never get full answers, also inside an internal network.
+func New(public bool, internal []netip.Prefix, proxies ...netip.Addr) *Guard {
+	g := &Guard{Public: public, proxies: map[netip.Addr]bool{}}
+	for _, p := range internal {
+		g.internal = append(g.internal, unmap(p))
+	}
+	for _, a := range proxies {
+		g.proxies[a.Unmap()] = true
+	}
+	return g
+}
+
+// unmap turns an IPv4-mapped IPv6 prefix into the IPv4 one, without host bits.
+func unmap(p netip.Prefix) netip.Prefix {
+	if p.Addr().Is4In6() {
+		p = netip.PrefixFrom(p.Addr().Unmap(), max(p.Bits()-96, 0))
+	}
+	return p.Masked()
+}
+
+// Full reports whether src may get answers larger than its requests: an
+// address of an internal network, or a loopback one (which the kernel only
+// takes from the host itself), that is not a proxy; any address when
+// Public is on.
+func (g *Guard) Full(src netip.Addr) bool {
+	if g == nil || g.Public {
+		return true
+	}
+	a := src.Unmap()
+	if g.proxies[a] {
+		return false
+	}
+	return a.IsLoopback() || g.Internal(a)
+}
+
+// Internal reports whether a is in one of the internal networks.
+func (g *Guard) Internal(a netip.Addr) bool {
+	if g == nil {
+		return false
+	}
+	a = a.Unmap()
+	for _, p := range g.internal {
+		if p.Contains(a) {
+			return true
+		}
+	}
+	return false
+}
+
+// Allow reports whether an answer of resp bytes may go to src for a request
+// of req bytes: never more bytes than the request, unless Full.
+func (g *Guard) Allow(src netip.Addr, req, resp int) bool {
+	return resp <= req || g.Full(src)
+}
+
+// MaxNets caps the networks of ParseNets.
+const MaxNets = 32
+
+var ula = netip.MustParsePrefix("fc00::/7")
+
+// narrowEnough: at most a /8 of IPv4, a /16 of IPv6 or the unique local
+// addresses of IPv6 (fc00::/7).
+func narrowEnough(p netip.Prefix) bool {
+	if p.Addr().Is4() {
+		return p.Bits() >= 8
+	}
+	return p.Bits() >= 16 || p.Bits() >= ula.Bits() && ula.Contains(p.Addr())
+}
+
+// ParseNets reads a list of networks separated by commas, each as an
+// address with its prefix length (10.20.0.0/16, fd00::/8), spaces allowed
+// around them. An empty list is valid. Host bits are cleared. A network
+// wider than /8 (IPv4), /16 (IPv6) or fc00::/7 is refused: it would make a
+// large part of the Internet internal, which is what
+// DDOSPOT_PUBLIC_AMPLIFICATION=on says out loud.
+func ParseNets(s string) ([]netip.Prefix, error) {
+	if strings.TrimSpace(s) == "" {
+		return nil, nil
+	}
+	var out []netip.Prefix
+	for _, f := range strings.Split(s, ",") {
+		f = strings.TrimSpace(f)
+		p, err := netip.ParsePrefix(f)
+		if err != nil {
+			return nil, fmt.Errorf("%q is not a network such as 10.20.0.0/16", f)
+		}
+		p = unmap(p)
+		if !narrowEnough(p) {
+			return nil, fmt.Errorf("%q is wider than /8 (IPv4), /16 (IPv6) or fc00::/7", f)
+		}
+		out = append(out, p)
+	}
+	if len(out) > MaxNets {
+		return nil, fmt.Errorf("more than %d networks", MaxNets)
+	}
+	return out, nil
+}
+
+// Gateways returns the gateways of the routes in route (/proc/net/route)
+// and route6 (/proc/net/ipv6_route). A file that is missing or does not
+// parse adds nothing.
+func Gateways(route, route6 string) []netip.Addr {
+	var out []netip.Addr
+	if f, err := os.Open(route); err == nil {
+		s := bufio.NewScanner(f)
+		for s.Scan() {
+			// Iface Destination Gateway Flags ...; Gateway in host order.
+			c := strings.Fields(s.Text())
+			if len(c) < 4 || c[0] == "Iface" {
+				continue
+			}
+			flags, err1 := strconv.ParseUint(c[3], 16, 16)
+			gw, err2 := strconv.ParseUint(c[2], 16, 32)
+			if err1 != nil || err2 != nil || flags&0x2 == 0 || gw == 0 { // RTF_GATEWAY
+				continue
+			}
+			var b [4]byte
+			binary.NativeEndian.PutUint32(b[:], uint32(gw))
+			out = append(out, netip.AddrFrom4(b))
+		}
+		f.Close()
+	}
+	if f, err := os.Open(route6); err == nil {
+		s := bufio.NewScanner(f)
+		for s.Scan() {
+			// dest plen src plen nexthop metric refcnt use flags iface
+			c := strings.Fields(s.Text())
+			if len(c) < 10 {
+				continue
+			}
+			b, err := hex.DecodeString(c[4])
+			if err != nil || len(b) != 16 {
+				continue
+			}
+			if a := netip.AddrFrom16([16]byte(b)); !a.IsUnspecified() {
+				out = append(out, a)
+			}
+		}
+		f.Close()
+	}
+	return out
+}

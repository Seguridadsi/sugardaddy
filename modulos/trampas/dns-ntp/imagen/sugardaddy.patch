+package jsonlog
+
+// Sugardaddy: the shares of the single file. One flood must not blind the
+// log for everyone else until midnight:
+//
+//   - Each kind of line has a line budget of its own: requests over UDP,
+//     whose source may be forged, never take the budget of requests over
+//     TCP, whose source completed a handshake, nor that of the bursts.
+//   - The bytes of a day are shared out: requests over UDP up to 60 %,
+//     bursts and networks up to 15 %, every line but the notices up to
+//     98 %, so that requests over TCP keep at least 23 %; the notices have
+//     the other 2 % (a line a minute all day takes under 1 % of 50 MB).
+//     The shares of UDP and of the bursts come through the day: a quarter
+//     at midnight and the rest evenly until the next one, so that under a
+//     flood they are sampled all day instead of spent in the first hours.
+//   - One source (an IPv4 address, an IPv6 /64) writes at most 2 % of the
+//     day for each kind, so that one host, however long it insists, cannot
+//     take the share of the others.
+//   - What is left out is not silent: Notice writes one log_dropped line a
+//     minute with how many lines of each kind, why and the sources that
+//     lost most; a kind that spends its share writes one log_full line.
+//
+// The file keeps its fixed name, its daily rotation and its total cap.
+
+import (
+	"cmp"
+	"fmt"
+	"math/bits"
+	"net/netip"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/telekom-security/ddospot/internal/bucket"
+)
+
+// Origin is who a line is about, for the shares of the single file: the
+// source of a request and whether it completed a TCP handshake. The zero
+// Origin is a line without a source, such as a target.
+type Origin struct {
+	Src      netip.Addr
+	Verified bool
+}
+
+// Events of the notices of the single file.
+const (
+	// FullEvent: a kind of line spent its share of the day; its later lines
+	// of that day are dropped and counted in the log_dropped lines.
+	FullEvent = "log_full"
+	// DroppedEvent: what the budgets and shares left out since the last one.
+	DroppedEvent = "log_dropped"
+)
+
+type kind int
+
+const (
+	unverified kind = iota // a request over UDP: the source may be forged
+	verified               // a request over TCP: the source completed a handshake
+	targetKind             // bursts and blocked networks
+	kinds
+)
+
+var (
+	// kindNames are the values of the field kind of log_full.
+	kindNames = [kinds]string{"peticiones UDP", "peticiones TCP", "ráfagas y redes"}
+	// kindFields count the dropped lines of each kind in log_dropped.
+	kindFields = [kinds]string{"dropped_udp", "dropped_tcp", "dropped_targets"}
+	// Line budgets per kind: together 10 lines a second, the 600 a minute
+	// that the sensor sends of one trap.
+	kindRates  = [kinds]float64{4, 3, 3}
+	kindBursts = [kinds]float64{150, 100, 200}
+	// Shares of the bytes of a day, per mille of the cap; verified has what
+	// the lines may take (linesShare) and the others leave.
+	kindShares = [kinds]int64{600, linesShare, 150}
+	// Whether the share comes through the day.
+	kindPaced = [kinds]bool{true, false, true}
+)
+
+const (
+	linesShare  = 980 // every line but the notices, per mille of the cap
+	sourceShare = 20  // one source and kind, per mille of the cap
+	paceHead    = 250 // per mille of a paced share there at midnight
+	// maxSources bounds the table of the bytes of each source; a source
+	// beyond it is not held to its share (the kind still is).
+	maxSources = 20000
+	// maxDropSources bounds the sources counted between two notices, and
+	// topSources is how many of them a notice names.
+	maxDropSources = 1024
+	topSources     = 5
+	daySeconds     = 24 * 60 * 60
+)
+
+type reason int
+
+const (
+	byRate   reason = iota // the line budget of the kind
+	bySource               // the share of the day of the source
+	byPace                 // the share of the kind that has come so far today
+	byDay                  // the share of the kind for the whole day
+	reasons
+)
+
+var reasonNames = [reasons]string{"ritmo de líneas", "cupo diario del origen", "reparto del día", "tope del día"}
+
+type srcKey struct {
+	addr     netip.Addr
+	verified bool
+}
+
+// drops is what was left out since the last notice.
+type drops struct {
+	kinds   [kinds]uint64
+	reasons [reasons]uint64
+	sources map[netip.Addr]uint64
+}
+
+// shares is the state of the shares of the single file; Writer holds it
+// and mu guards it.
+type shares struct {
+	lines    [kinds]*bucket.Bucket
+	used     [kinds]int64
+	notices  int64        // bytes of the notices today
+	kindFull [kinds]bool  // its share of today is spent and its log_full written
+	lastSize [kinds]int64 // of the last line of the kind, for the guess of Allow
+	srcUsed  map[srcKey]int64
+	period   drops
+}
+
+func (s *shares) init() {
+	for k := range kinds {
+		s.lines[k] = bucket.New(kindRates[k], kindBursts[k])
+	}
+	s.newDay()
+}
+
+func (s *shares) newDay() {
+	s.used = [kinds]int64{}
+	s.notices = 0
+	s.kindFull = [kinds]bool{}
+	s.srcUsed = map[srcKey]int64{}
+}
+
+func kindOf(file string, o Origin) kind {
+	switch {
+	case file == targetsFile:
+		return targetKind
+	case o.Verified:
+		return verified
+	}
+	return unverified
+}
+
+// sourceOf is the address a source is counted by: an IPv6 host has a /64.
+func sourceOf(a netip.Addr) netip.Addr {
+	a = a.Unmap()
+	if a.Is6() {
+		a = netip.PrefixFrom(a, 64).Masked().Addr()
+	}
+	return a
+}
+
+// part returns perMille of the cap.
+func (w *Writer) part(perMille int64) int64 { return w.maxBytes * perMille / 1000 }
+
+// limitOf returns the bytes kind k may have written by now today. A paced
+// share grows every second, not in steps of a thousandth of it (31 KB
+// every two minutes with the 50 MB of the trap), which under a flood left
+// UDP silent up to two minutes at a time. The product is taken in 128 bits:
+// share*num cannot overflow, and the quotient is at most share.
+func (w *Writer) limitOf(k kind, now time.Time) int64 {
+	share := w.part(kindShares[k])
+	if !kindPaced[k] || share <= 0 {
+		return share
+	}
+	u := now.UTC()
+	secs := uint64(u.Hour()*3600 + u.Minute()*60 + u.Second())
+	num := paceHead*daySeconds + (1000-paceHead)*secs
+	hi, lo := bits.Mul64(uint64(share), num)
+	q, _ := bits.Div64(hi, lo, 1000*daySeconds)
+	return int64(q)
+}
+
+// chargeEarlier charges the n bytes that an earlier run wrote today to
+// the paced shares, whose kinds the file does not tell apart: to requests
+// over UDP as much as they may have written by now, the rest to the bursts
+// as much as theirs, and what is left counts only in the cap and in the
+// share of the lines, which is what holds the requests over TCP. Charging
+// it all to UDP left UDP silent for hours under a flood after a restart,
+// paying for the TCP lines and notices of the morning; charging nothing
+// would give the paced kinds their morning twice. Called with mu held,
+// once a day at most, after Cap.
+func (w *Writer) chargeEarlier(n int64, now time.Time) {
+	for _, k := range [...]kind{unverified, targetKind} {
+		c := min(n, w.limitOf(k, now))
+		w.used[k] = c
+		n -= c
+	}
+}
+
+// check tells whether a line of size bytes of kind k about o fits now, or
+// why not. Called with mu held, after rotate.
+func (w *Writer) check(k kind, o Origin, size int64, now time.Time) (reason, bool) {
+	if w.maxBytes > 0 {
+		switch {
+		case w.kindFull[k] || w.bytes-w.notices+size > w.part(linesShare) || w.used[k]+size > w.part(kindShares[k]):
+			return byDay, false
+		case w.used[k]+size > w.limitOf(k, now):
+			return byPace, false
+		case o.Src.IsValid() && w.srcUsed[srcKey{sourceOf(o.Src), o.Verified}]+size > w.part(sourceShare):
+			return bySource, false
+		}
+	}
+	if !w.lines[k].Can(1, now) {
+		return byRate, false
+	}
+	return 0, true
+}
+
+// drop counts a line left out; the first one of a kind that spent its
+// share of the day also writes the log_full line of that kind. Called with
+// mu held, after rotate.
+func (w *Writer) drop(k kind, o Origin, r reason, now time.Time) {
+	if r == byDay && !w.kindFull[k] {
+		w.kindFull[k] = true
+		w.notice(map[string]any{"event": FullEvent, "time": Time(now), "max_bytes": w.maxBytes,
+			"kind": kindNames[k], "kind_bytes": w.part(kindShares[k])})
+	}
+	w.dropped++
+	p := &w.period
+	p.kinds[k]++
+	p.reasons[r]++
+	if !o.Src.IsValid() {
+		return
+	}
+	if p.sources == nil {
+		p.sources = map[netip.Addr]uint64{}
+	}
+	a := sourceOf(o.Src)
+	if _, ok := p.sources[a]; ok || len(p.sources) < maxDropSources {
+		p.sources[a]++
+	}
+}
+
+// allowShared is AllowFrom for the single file: a line as long as the
+// last one of its kind must fit, so that a caller under a flood does not
+// build lines that Write would leave out. Called with mu held.
+func (w *Writer) allowShared(file string, o Origin, now time.Time) bool {
+	w.rotate(now)
+	k := kindOf(file, o)
+	if r, ok := w.check(k, o, max(w.lastSize[k], 1), now); !ok {
+		w.drop(k, o, r, now)
+		return false
+	}
+	return true
+}
+
+// writeShared is WriteFrom for the single file. Called with mu held.
+func (w *Writer) writeShared(file string, o Origin, ev map[string]any, now time.Time) {
+	w.rotate(now)
+	k := kindOf(file, o)
+	if r, ok := w.check(k, o, 1, now); !ok {
+		w.drop(k, o, r, now) // without encoding the line
+		return
+	}
+	buf, ok := w.encode(ev)
+	if !ok {
+		return
+	}
+	size := int64(buf.Len())
+	w.lastSize[k] = size
+	if r, ok := w.check(k, o, size, now); !ok {
+		w.drop(k, o, r, now)
+		if r == bySource {
+			// Spent for today: Allow says no from now on.
+			w.addSource(o, w.part(sourceShare))
+		}
+		return
+	}
+	f := w.open(w.single)
+	if f == nil {
+		return
+	}
+	w.lines[k].Take(1, now)
+	n := w.append(f, buf.Bytes())
+	w.used[k] += n
+	w.addSource(o, w.srcUsed[srcKey{sourceOf(o.Src), o.Verified}]+n)
+}
+
+// addSource sets the bytes of today of the source of o, if it has one and
+// it is in the table or the table has room.
+func (w *Writer) addSource(o Origin, n int64) {
+	if !o.Src.IsValid() {
+		return
+	}
+	key := srcKey{sourceOf(o.Src), o.Verified}
+	if _, ok := w.srcUsed[key]; ok || len(w.srcUsed) < maxSources {
+		w.srcUsed[key] = n
+	}
+}
+
+// notice writes a notice line within the share of the notices and the cap
+// of the day, outside the line budgets. Called with mu held, after rotate.
+func (w *Writer) notice(ev map[string]any) {
+	buf, ok := w.encode(ev)
+	if !ok {
+		return
+	}
+	size := int64(buf.Len())
+	if w.maxBytes > 0 && (w.notices+size > w.part(1000-linesShare) || w.bytes+size > w.maxBytes) {
+		w.dropped++
+		return
+	}
+	if f := w.open(w.single); f != nil {
+		w.notices += w.append(f, buf.Bytes())
+	}
+}
+
+// Notice writes one log_dropped line into the single file with what the
+// budgets and shares left out since the last call: how many lines of each
+// kind, the limits that left them out and the sources that lost most. With
+// untracked, the packets of new sources that the limiter could not hold
+// because its tables were full. It writes nothing when nothing was left
+// out, without a single file or after Close. Call it once a minute.
+func (w *Writer) Notice(untracked uint64) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed || w.single == "" {
+		return
+	}
+	now := w.now()
+	w.rotate(now)
+	p := w.period
+	w.period = drops{}
+	var total uint64
+	for _, n := range p.kinds {
+		total += n
+	}
+	if total == 0 && untracked == 0 {
+		return
+	}
+	ev := map[string]any{"event": DroppedEvent, "time": Time(now), "dropped": total}
+	for k, n := range p.kinds {
+		if n > 0 {
+			ev[kindFields[k]] = n
+		}
+	}
+	if untracked > 0 {
+		ev["untracked"] = untracked
+	}
+	var why []string
+	for r, n := range p.reasons {
+		if n > 0 {
+			why = append(why, reasonNames[r])
+		}
+	}
+	if len(why) > 0 {
+		ev["limits"] = strings.Join(why, ", ")
+	}
+	if top := topOf(p.sources); top != "" {
+		ev["top_sources"] = top
+	}
+	w.notice(ev)
+}
+
+// topOf names the sources that lost most lines, with their counts.
+func topOf(m map[netip.Addr]uint64) string {
+	type count struct {
+		a netip.Addr
+		n uint64
+	}
+	var all []count
+	for a, n := range m {
+		all = append(all, count{a, n})
+	}
+	slices.SortFunc(all, func(x, y count) int {
+		if c := cmp.Compare(y.n, x.n); c != 0 {
+			return c
+		}
+		return x.a.Compare(y.a)
+	})
+	var out []string
+	for _, c := range all[:min(len(all), topSources)] {
+		out = append(out, fmt.Sprintf("%s (%d)", c.a, c.n))
+	}
+	return strings.Join(out, ", ")
+}

# Entrada HTTPS de la consola del nodo. Lo único del nodo que escucha hacia la
# red del cliente, junto con las trampas.
#
# Un solo fichero para los dos modos de entrada: viaja firmado con cada versión
# y el actualizador lo escribe tal cual, así que el modo no puede vivir aquí.
# Vive en .env y compose.yml lo pasa en CADDY_MODO, que elige el sitio de abajo:
#  - Fijo (por defecto): solo la dirección dada al instalar.
#  - «Cualquier IP o nombre» (ENTRAR_CUALQUIER_IP=1 al instalar): :443 para
#    cualquier host, con certificado a demanda. Con la CA de Caddy de antes,
#    en un nodo con IP pública Caddy puede emitir certificados a quien se los
#    pida (riesgo menor; por eso NO es el modo por defecto); con la CA propia,
#    solo para la dirección de la consola (ask, abajo).
#
# La CA con la que firma Caddy en TLS_MODO=interno (docs/diseno/ca-nodo.md) la
# elige CA_NODO de .env, que compose pasa en CADDY_CA:
#  - «nodo»: la CA propia del nodo, en ca-nodo/. Su raíz solo vale para la
#    dirección de la consola; Caddy firma con la intermedia y no tiene la clave
#    de la raíz.
#  - «local» (nodos instalados antes): la CA que Caddy crea en su volumen, sin
#    límite de nombres, hasta que el administrador pasa a la propia desde la
#    consola.
# Los fragmentos que elige tienen que estar antes del bloque global.

# TLS explícito, el mismo en todos los modos (plan de fortificación, 0.5): solo
# TLS 1.2 y 1.3; en 1.2, solo suites ECDHE con AEAD (AES-GCM y ChaCha20), para
# certificado ECDSA (la CA del nodo) y RSA (el que deje el cliente en certs/). Las
# de TLS 1.3 son todas AEAD y Go no deja elegirlas. Curvas: la híbrida
# poscuántica, X25519, P-256 y P-384.
(tls-politica) {
	protocols tls1.2 tls1.3
	ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	curves x25519mlkem768 x25519 secp256r1 secp384r1
}

# Certificado de cliente de los sensores remotos (docs/diseno/mtls-sensores.md). Lo
# elige CA_SENSORES de .env, que pone el actualizador con la raíz de la CA de
# sensores de la consola; compose pasa CADDY_SENSORES («-si» si la hay) y la raíz
# en DER (base64). Sin ella, como antes: no se pide certificado.
#  - verify_if_given: el navegador no tiene ninguno de esa CA y entra igual; un
#    certificado presentado tiene que ser de esa raíz y para clientAuth, o el TLS
#    se corta. Qué sensor es y si está revocado lo decide la consola.
#  - A la consola le llegan la huella del certificado y si Caddy lo pide. Las
#    mismas cabeceras que lleguen de fuera se quitan siempre: no se pueden fingir.
(cliente-sensores) {
}

(cliente-sensores-si) {
	client_auth {
		mode verify_if_given
		trust_pool inline {
			trust_der {$CA_SENSORES}
		}
	}
}

(cabeceras-sensores) {
	header_up -X-Sugardaddy-Certificado
	header_up -X-Sugardaddy-Mtls
}

(cabeceras-sensores-si) {
	header_up X-Sugardaddy-Certificado {http.request.tls.client.fingerprint}
	header_up X-Sugardaddy-Mtls 1
}

(ca-local) {
}

(ca-nodo) {
	pki {
		ca nodo {
			name "Sugardaddy node"
			root {
				cert /ca-nodo/raiz.crt
			}
			intermediate {
				cert /ca-nodo/intermedia.crt
				key /ca-nodo/intermedia.key
			}
		}
	}
	# Modo «cualquier IP o nombre»: Caddy solo pide certificado a demanda para
	# la dirección de la consola, la única que permite la raíz. Contesta el
	# sitio del 127.0.0.1 de abajo, dentro de este mismo contenedor.
	on_demand_tls {
		ask http://127.0.0.1:5555/permiso
	}
}

{
	admin off
	# Sin peticiones a Let's Encrypt ni a ningún sitio: el nodo no sale a
	# buscar certificados.
	auto_https disable_redirects
	skip_install_trust
	# Al entrar por IP el navegador no manda SNI; para una IP (sobre todo pública)
	# Caddy no sabría qué certificado presentar y abortaría el TLS (internal error).
	# Con esto usa el de la dirección del nodo cuando no hay SNI, así se entra por IP.
	default_sni {$CONSOLA_DOMINIO}
	# Con certificado de cliente (sensores remotos, abajo) Caddy exige que el SNI
	# coincida con el Host, y al entrar por IP no coinciden (SNI vacío, Host la IP):
	# contestaba 421 a todo el que entrara por IP en cuanto el nodo tenía un sensor
	# remoto. Se apaga porque solo hay un sitio HTTPS: no hay otro al que saltar con
	# el certificado de un sensor, y qué sensor es lo decide la consola por la huella.
	servers {
		strict_sni_host insecure_off
	}
	import ca-{$CADDY_CA}
}

(tls-interno) {
	# CA del nodo (la elegida arriba). Su raíz la dejan en ca-raiz.crt
	# instalar.sh o el actualizador, para instalarla en los equipos que entren
	# a la consola.
	tls {
		import tls-politica
		import cliente-sensores{$CADDY_SENSORES}
		issuer internal {
			ca {$CADDY_CA}
		}
	}
}

(tls-interno-a-demanda) {
	# Igual, pero emite el certificado del host con que te conectes (sin esto,
	# en :443 un SNI nuevo rompería el TLS). Sin SNI (al entrar por IP), el de
	# default_sni.
	tls {
		import tls-politica
		import cliente-sensores{$CADDY_SENSORES}
		issuer internal {
			ca {$CADDY_CA}
		}
		on_demand
	}
}

(tls-ficheros) {
	# Certificado de la CA del cliente, dejado en certs/ por quien instala.
	tls /certs/certificado.pem /certs/clave.pem {
		import tls-politica
		import cliente-sensores{$CADDY_SENSORES}
	}
}

(tls-ficheros-a-demanda) {
	# Con certificado propio no se emite nada: el mismo para cualquier host.
	tls /certs/certificado.pem /certs/clave.pem {
		import tls-politica
		import cliente-sensores{$CADDY_SENSORES}
	}
}

(consola) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy consola:3000 {
		import cabeceras-sensores{$CADDY_SENSORES}
	}
}

# Modo fijo (CADDY_MODO vacío).
(sitio) {
	{$CONSOLA_DOMINIO}:443 {
		import tls-{$TLS_MODO}
		import consola
	}
}

# Modo «cualquier IP o nombre» (CADDY_MODO=-cualquier-ip).
(sitio-cualquier-ip) {
	:443 {
		import tls-{$TLS_MODO}-a-demanda
		import consola
	}
	# El «ask» de la CA propia: sí solo a la dirección de la consola. Solo en
	# el bucle local del contenedor; con la CA de antes nadie lo pregunta.
	http://127.0.0.1:5555 {
		bind 127.0.0.1
		@consola query domain={$CONSOLA_DOMINIO}
		respond @consola 200
		respond 403
	}
}

import sitio{$CADDY_MODO}

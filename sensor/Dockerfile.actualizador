# Actualizador del nodo, que desde la 0.12 también hace de auxiliar: aplica la
# configuración firmada de cada versión con docker-compose. El binario de
# compose lo descarga herramientas/publicar-version.sh, comprobado contra la
# huella fijada en herramientas/compose.sha256, y llega en dist/.
#   docker build -f sensor/Dockerfile.actualizador --build-arg VERSION=0.12.0 sensor

FROM golang:1.27-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS construccion
ARG VERSION=dev
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=$VERSION" -o /out/actualizador ./cmd/actualizador

# Alpine con iptables: el actualizador también hace de auxiliar del acceso a la
# consola (orden «cortafuegos», docs/diseno/acceso-consola.md), que pone la regla
# en el cortafuegos de la máquina con el iptables que use Docker allí (nft o
# legacy). Y del de los discos de las trampas (orden «disco»,
# docs/diseno/discos-trampa.md), con e2fsprogs (mkfs.ext4, e2fsck) y el mount,
# umount y losetup de util-linux, que reutiliza el dispositivo loop de un fichero
# que ya lo tiene en vez de montarlo dos veces. Corre como root porque habla con
# el socket de Docker, que ya equivale a root en la máquina: la shell de Alpine
# no le da nada que no tuviera.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
RUN apk add --no-cache iptables iptables-legacy e2fsprogs mount umount losetup
# El binario de compose de la arquitectura de la imagen (en producción, amd64).
ARG COMPOSE=dist/docker-compose-linux-amd64
COPY --from=construccion /out/actualizador /app
COPY ${COMPOSE} /docker-compose
USER 0
ENTRYPOINT ["/app"]

{
  "version": 1,
  "id": "cowrie",
  "nombre": "Fake SSH and Telnet",
  "descripcion": "An SSH and Telnet server that accepts weak credentials and drops the attacker into a simulated shell. It records every access attempt, every command and every download, and flags an attacker driving an AI agent: the simulated system carries a file that only an AI agent reads and follows. The file can be switched off.",
  "ficha": {
    "detecta": "Anyone trying to get in over SSH or Telnet: the passwords they try, the commands they type, what they try to download and whether they want to use the machine as a stepping stone to others. It also tells when the attacker is driving an AI agent.",
    "donde": "Where an attacker would look for Linux servers: the server network, the DMZ or a user VLAN. With a hostname and a port that fit those on your network.",
    "requisitos": [
      "A Linux sensor with Docker (the node's own or one installed on another machine).",
      "Open in that machine's firewall the port you choose."
    ],
    "instalacion": {
      "automatica": true
    }
  },
  "versionModulo": "0.2.3",
  "tipo": "contenedor",
  "procedencia": {
    "proyecto": "Cowrie",
    "url": "https://github.com/cowrie/cowrie",
    "licencia": "BSD-3-Clause"
  },
  "contenedor": {
    "imagen": "ghcr.io/seguridadsi/sugardaddy-trampa-cowrie:3.1.2-sd6@sha256:bc13ebd36035ba1d610ec09d92b2e670cf438ef075f64a9007ba7935f7cfe8f9",
    "puertos": [
      {
        "interno": 2222,
        "expuesto": "${puertoSsh}",
        "protocolo": "tcp"
      },
      {
        "interno": 2223,
        "expuesto": "${puertoTelnet}",
        "protocolo": "tcp",
        "si": "telnet"
      }
    ],
    "entorno": {
      "COWRIE_HONEYPOT_HOSTNAME": "${nombreEquipo}",
      "COWRIE_TELNET_ENABLED": "${telnet}",
      "COWRIE_HONEYPOT_ETC_PATH": "/cowrie/sd-etc",
      "COWRIE_HONEYPOT_DOWNLOAD_LIMIT_SIZE": "10485760",
      "COWRIE_HONEYPOT_DOWNLOAD_PATH": "/tmp",
      "COWRIE_HONEYPOT_TTYLOG": "false",
      "COWRIE_HONEYPOT_TTYLOG_PATH": "/tmp",
      "COWRIE_OUTPUT_JSONLOG_MAX_BYTES_DAY": "52428800",
      "COWRIE_SSH_VERSION": {
        "segun": "sistema",
        "valores": {
          "debian-12": "SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u3",
          "ubuntu-22": "SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.6"
        }
      },
      "COWRIE_SHELL_KERNEL_VERSION": {
        "segun": "sistema",
        "valores": {
          "debian-12": "6.1.0-21-amd64",
          "ubuntu-22": "5.15.0-91-generic"
        }
      },
      "COWRIE_SHELL_KERNEL_BUILD_STRING": {
        "segun": "sistema",
        "valores": {
          "debian-12": "#1 SMP PREEMPT_DYNAMIC Debian 6.1.90-1 (2024-05-03)",
          "ubuntu-22": "#101-Ubuntu SMP Tue Nov 14 13:30:08 UTC 2023"
        }
      },
      "COWRIE_SHELL_FILESYSTEM": {
        "segun": "sistema",
        "valores": {
          "debian-12": "/cowrie/cowrie-git/src/cowrie/data/fs-debian-12.pickle",
          "ubuntu-22": "/cowrie/cowrie-git/src/cowrie/data/fs-ubuntu-22.pickle"
        }
      },
      "COWRIE_SSH_KEX": {
        "segun": "sistema",
        "valores": {
          "debian-12": "curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521",
          "ubuntu-22": "curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521"
        }
      },
      "COWRIE_SSH_CIPHERS": {
        "segun": "sistema",
        "valores": {
          "debian-12": "aes128-ctr,aes192-ctr,aes256-ctr",
          "ubuntu-22": "aes128-ctr,aes192-ctr,aes256-ctr"
        }
      },
      "COWRIE_SSH_MACS": "hmac-sha2-256,hmac-sha2-512,hmac-sha1",
      "COWRIE_SSH_COMPRESSION": "none,zlib@openssh.com",
      "COWRIE_HONEYPOT_SD_NOTA_AGENTES": "${notaAgentes}"
    },
    "ficheros": [
      {
        "destino": "/cowrie/sd-etc/userdb.txt",
        "contenido": "${accesos}"
      }
    ],
    "escribibles": [
      "/cowrie/cowrie-git/var/lib/cowrie"
    ],
    "registros": "/cowrie/cowrie-git/var/log/cowrie"
  },
  "aislamiento": {
    "salida": false,
    "soloLectura": true,
    "cpu": 0.5,
    "memoriaMb": 256
  },
  "parametros": {
    "type": "object",
    "required": [
      "nombreEquipo",
      "puertoSsh",
      "sistema",
      "accesos"
    ],
    "properties": {
      "nombreEquipo": {
        "type": "string",
        "x-camuflaje": "host:bak",
        "title": "Computer name",
        "description": "The one the attacker will see in the prompt. It should fit the names on the network.",
        "pattern": "^[a-zA-Z0-9-]{1,63}$",
        "default": "srv-backup01"
      },
      "puertoSsh": {
        "type": "integer",
        "title": "SSH port",
        "description": "22 is the most believable, but only if the machine does not already use 22 for its real SSH.",
        "minimum": 1,
        "maximum": 65535,
        "default": 2222
      },
      "telnet": {
        "type": "string",
        "title": "Telnet",
        "description": "An open Telnet attracts a lot of automated attack (cameras, routers). If not enabled, its port is not opened.",
        "enum": [
          "yes",
          "no"
        ],
        "x-opciones": {
          "yes": "Yes",
          "no": "No"
        },
        "default": "no"
      },
      "puertoTelnet": {
        "type": "integer",
        "title": "Telnet port",
        "description": "Only matters if Telnet is set to Yes. 23 is the usual one.",
        "minimum": 1,
        "maximum": 65535,
        "default": 2223
      },
      "sistema": {
        "type": "string",
        "title": "System it pretends to be",
        "description": "Changes the SSH version it announces and what uname returns.",
        "enum": [
          "debian-12",
          "ubuntu-22"
        ],
        "x-opciones": {
          "debian-12": "Debian 12",
          "ubuntu-22": "Ubuntu 22.04"
        },
        "default": "debian-12"
      },
      "accesos": {
        "type": "string",
        "title": "Users and passwords that let in",
        "description": "One rule per line, user:x:password. A * matches any and a ! in front rejects it. They apply in order: with root:x:!root and then root:x:*, root gets in with anything except \"root\".",
        "x-multilinea": true,
        "pattern": "^([^:\\s]{1,64}:x:[^\\s]{1,128}(\\r?\\n|$))+$",
        "maxLength": 4000,
        "default": "root:x:!root\nroot:x:!123456\nroot:x:*\nadmin:x:*\nubuntu:x:*"
      },
      "notaAgentes": {
        "type": "string",
        "title": "Note for AI agents",
        "description": "Adds to the simulated system a file named AGENTS.md, in the home directory of its user account, asking AI assistants and automated agents to register the session with a command before doing anything else. A command that names that file is recorded as a suspected AI agent, and running the command the file asks for is recorded as a confirmed one. When it is off, the file does not exist and no command is flagged. The file is visible to anyone who lists that directory.",
        "enum": [
          "si",
          "no"
        ],
        "x-opciones": {
          "si": "On",
          "no": "Off"
        },
        "default": "si"
      }
    }
  },
  "eventos": {
    "fuente": {
      "tipo": "fichero",
      "ruta": "cowrie.json"
    },
    "formato": "json-lineas",
    "campos": {
      "cuando": "timestamp",
      "ip": "src_ip",
      "puerto": "src_port",
      "usuario": "username"
    },
    "accion": {
      "campo": "eventid",
      "valores": {
        "cowrie.session.connect": "conexion",
        "cowrie.login.success": "autenticacion",
        "cowrie.login.failed": "autenticacion",
        "cowrie.command.input": "comando",
        "cowrie.command.failed": "comando",
        "cowrie.session.file_download": "descarga",
        "cowrie.session.file_upload": "escritura"
      },
      "porDefecto": "otra",
      "ignorar": [
        "cowrie.log.closed",
        "cowrie.client.size",
        "cowrie.session.params"
      ]
    },
    "severidad": {
      "porDefecto": "media",
      "porAccion": {
        "autenticacion": "alta",
        "comando": "critica",
        "descarga": "critica",
        "escritura": "critica"
      },
      "porValor": {
        "cowrie.client.version": "baja",
        "cowrie.client.kex": "baja",
        "cowrie.session.closed": "baja",
        "cowrie.direct-tcpip.request": "critica",
        "cowrie.direct-tcpip.data": "critica",
        "cowrie.sugardaddy.log_full": "alta",
        "cowrie.sugardaddy.log_dropped": "alta"
      }
    },
    "conexionEstablecida": true,
    "detalle": [
      "eventid",
      "session",
      "protocol",
      "password",
      "input",
      "url",
      "outfile",
      "filename",
      "shasum",
      "size",
      "version",
      "hassh",
      "duration",
      "dst_ip",
      "dst_port",
      "data",
      "ja4",
      "agente_ia",
      "motivo",
      "recortado",
      "aviso",
      "lleno",
      "tope_bytes",
      "omitidos",
      "por_cupo_ip",
      "por_cupo_accesos",
      "por_registro_lleno",
      "de_su_ip",
      "ips_distintas",
      "ips_sin_contar",
      "eventos",
      "periodo_s"
    ],
    "sesion": "session",
    "contrasena": "password",
    "resumen": [
      "password",
      "input",
      "motivo",
      "url",
      "filename",
      "version",
      "duration",
      "data",
      "aviso",
      "omitidos"
    ],
    "etiquetas": {
      "session": "Session",
      "protocol": "Protocol",
      "password": "Password",
      "input": "Command",
      "url": "Download from",
      "outfile": "Saved to",
      "filename": "File",
      "shasum": "SHA-256",
      "size": "Size",
      "version": "Client",
      "hassh": "Client fingerprint (HASSH)",
      "duration": "Duration (s)",
      "dst_ip": "Target",
      "dst_port": "Destination port",
      "data": "Sends",
      "ja4": "TLS fingerprint (JA4)",
      "motivo": "Reason",
      "recortado": "Truncated (original size)",
      "aviso": "Alert",
      "lleno": "Part full",
      "tope_bytes": "Daily limit (bytes)",
      "omitidos": "Events not recorded",
      "por_cupo_ip": "By its source's limit",
      "por_cupo_accesos": "By the access limit",
      "por_registro_lleno": "By the full log",
      "de_su_ip": "From that IP",
      "ips_distintas": "Distinct IPs",
      "ips_sin_contar": "From IPs not counted one by one",
      "eventos": "What was silenced",
      "periodo_s": "Period (s)",
      "cowrie.session.connect": "Connection",
      "cowrie.client.version": "SSH client",
      "cowrie.client.kex": "Cipher negotiation",
      "cowrie.login.success": "Signs in",
      "cowrie.login.failed": "Password rejected",
      "cowrie.command.input": "Command",
      "cowrie.command.failed": "Unknown command",
      "cowrie.session.file_download": "Download",
      "cowrie.session.file_upload": "Uploads a file",
      "cowrie.direct-tcpip.request": "Tries to use it as a stepping stone",
      "cowrie.direct-tcpip.data": "Sends through the tunnel",
      "cowrie.direct-tcpip.ja4": "TLS fingerprint through the tunnel",
      "cowrie.session.closed": "Leaves",
      "cowrie.sugardaddy.log_full": "Today's log is full (that part), summarized until tomorrow",
      "cowrie.sugardaddy.log_dropped": "Events not recorded due to limit (summary)"
    }
  }
}

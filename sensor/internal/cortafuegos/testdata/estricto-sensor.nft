# Sugardaddy: strict host firewall (docs/diseno/cortafuegos-anfitrion.md). Generated: do not edit.
table inet sugardaddy
delete table inet sugardaddy
table inet sugardaddy {
	set consola4 {
		type ipv4_addr
		flags interval
	}
	set consola6 {
		type ipv6_addr
		flags interval
	}
	set ssh4 {
		type ipv4_addr
		flags interval
		elements = { 10.20.0.0/16 }
	}
	set ssh6 {
		type ipv6_addr
		flags interval
	}
	set publicados {
		type inet_proto . inet_service
		elements = { tcp . 21, tcp . 443, udp . 161 }
	}
	set salida4 {
		type ipv4_addr . inet_service
		elements = { 10.0.0.5 . 443, 20.1.2.3 . 443 }
	}
	set salida6 {
		type ipv6_addr . inet_service
	}

	chain entrada {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		# SEN-5: a taken decoy cannot reach the machine through its bridge gateway.
		iifname "sd-trampas*" drop
		meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		meta l4proto icmp icmp type echo-request limit rate 10/second accept
		meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 10/second accept
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept
		# The node's own containers reach its published ports (Docker's proxy, same bridge).
		iifname "docker0" meta l4proto . th dport @publicados accept
		iifname "br-*" meta l4proto . th dport @publicados accept
		meta l4proto . th dport @publicados accept
		tcp dport 22 ip saddr @ssh4 accept
		tcp dport 22 ip6 saddr @ssh6 accept
		# The rest, as a closed port of any machine: a silent (filtered) port draws attention.
		meta l4proto tcp reject with tcp reset
		meta l4proto udp reject
	}

	chain adelante {
		type filter hook forward priority filter; policy accept;
		ct state established,related accept
		ct state invalid drop
		ct status dnat meta l4proto . ct original proto-dst @publicados accept
		# A published port that is not the node's: nobody reaches it.
		ct state new ct status dnat meta l4proto tcp reject with tcp reset
		ct state new ct status dnat drop
		# Restricted outbound: only to the list (plus DNS and NTP).
		ct state new oifname "docker0" accept
		ct state new oifname "br-*" accept
		ct state new oifname "sd-trampas*" accept
		ct state new meta l4proto { tcp, udp } th dport 53 accept
		ct state new udp dport 123 accept
		ct state new ip daddr . tcp dport @salida4 accept
		ct state new ip6 daddr . tcp dport @salida6 accept
		ct state new meta l4proto tcp reject with tcp reset
		ct state new reject with icmpx type admin-prohibited
	}

	chain salida {
		type filter hook output priority filter; policy accept;
		oif "lo" accept
		ct state established,related accept
		meta l4proto { icmp, ipv6-icmp } accept
		udp dport { 67, 547 } accept
		ct state new oifname "docker0" accept
		ct state new oifname "br-*" accept
		ct state new oifname "sd-trampas*" accept
		ct state new meta l4proto { tcp, udp } th dport 53 accept
		ct state new udp dport 123 accept
		ct state new ip daddr . tcp dport @salida4 accept
		ct state new ip6 daddr . tcp dport @salida6 accept
		ct state new meta l4proto tcp reject with tcp reset
		ct state new reject with icmpx type admin-prohibited
	}
}
